# 统一换行符，避免 Windows(CRLF) 与 macOS/Linux(LF) 互相制造「整个文件都变了」的假冲突
* text=auto eol=lf

# 源码与文档明确用 LF
*.js    text eol=lf
*.json  text eol=lf
*.wxml  text eol=lf
*.wxss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# 二进制：不要让 git 做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.pdf   binary
*.zip   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
