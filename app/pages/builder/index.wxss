/* ================= 表单 ================= */

.nameinput {
  height: 96rpx;
  padding: 0 var(--sp3);
  border-radius: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: var(--fs-h2);
  color: var(--ink);
  font-family: inherit;
}

.chips {
  display: flex;
}

.chip {
  flex: 1;
  height: 88rpx;
  margin-right: var(--sp2);
  border-radius: 44rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--muted);
  transition: background .15s, color .15s, border-color .15s;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: var(--green);
  border-color: var(--green);
  color: #F6F4EA;
}

.hint {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted2);
}

/* ================= 训练日卡 ================= */

.daycard {
  margin-bottom: var(--sp2);
  padding: var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.dayhead {
  display: flex;
  align-items: baseline;
  padding-bottom: var(--sp2);
  border-bottom: 1rpx solid var(--line);
}

.daykey {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  color: var(--clay);
  margin-right: 12rpx;
}

.dayname {
  font-size: var(--fs-h2);
}

.daycount {
  margin-left: auto;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.dayex {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dayno {
  width: 28rpx;
  color: var(--muted2);
  font-size: var(--fs-note);
}

.dayexl {
  flex: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.dayexcn {
  font-size: var(--fs-body);
}

.dayexmeta {
  margin-left: 12rpx;
  font-size: var(--fs-label);
  letter-spacing: .06em;
  color: var(--muted2);
}

.dayexdel {
  padding: 8rpx 4rpx 8rpx 24rpx;
  font-size: var(--fs-note);
  color: var(--clay);
}

.dayempty {
  padding: var(--sp2) 0;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.dayadd {
  margin-top: var(--sp2);
  height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx dashed rgba(60, 74, 50, .3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--green);
}

.dayadd-hover {
  background: var(--card-press);
  transform: translateY(1rpx) scale(.996);
}

.tipsline {
  margin-top: var(--sp3);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted2);
}

/* ================= 底部固定按钮 ================= */

.footfix {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp2) var(--sp3) calc(var(--sp2) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 62%, rgba(242, 240, 230, 0));
}

.savebtn {
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--green);
  color: #F6F4EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  letter-spacing: .08em;
}

.savebtn-hover {
  background: var(--green-deep);
  transform: translateY(1rpx) scale(.996);
}

/* ================= 抽屉 ================= */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 35, 28, .38);
  opacity: 0;
  visibility: hidden;
  transition: opacity .22s;
  z-index: 20;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  height: 78vh;
  /* 不用 flex 列：scroll-view 一旦参与 flex 尺寸计算，iOS 就会按内容高度把它算成
     撑爆整个抽屉（chip 被压、footer 被顶出去）。这里三段全部走块级流 + 显式高度，
     列表用 calc 精确扣掉头尾 —— 微信里最保守、最不会出偏差的写法。 */
  overflow: hidden;
  background: var(--bg);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  transform: translateY(102%);
  transition: transform .28s cubic-bezier(.23, .9, .3, 1);
}

.sheet.up {
  transform: translateY(0);
}

.sheeth {
  /* 定高 120rpx = 上留白 40 + 文字行 56 + 下留白 24，给下面的 calc 一个准确的头高 */
  height: 120rpx;
  box-sizing: border-box;
  padding: var(--sp3) var(--sp3) 0;
  line-height: 56rpx;
  display: flex;
  align-items: baseline;
}

.sheettitle {
  font-size: var(--fs-h2);
}

.sheetdone {
  margin-left: auto;
  font-size: var(--fs-note);
  color: var(--green);
}

.parttabs {
  /* 横向 chip 行：死高度 88rpx（chip 64 + 下留白 24），border-box 收进去 */
  height: 88rpx;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 0 var(--sp3) var(--sp2);
}

.ptab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: var(--fs-note);
  color: var(--muted);
}

.ptab.on {
  background: var(--green);
  border-color: var(--green);
  color: #F6F4EA;
}

.exscroll {
  /* 高度 = 抽屉高 − 头 120rpx − chip 88rpx − 底 128rpx − 安全区（用 vw 表达 rpx：
     1rpx = 100/750 vw，所以 336rpx = 44.8vw）。scroll-view 拿到明确的像素高度，
     既不需要参与任何 flex 计算，也不依赖 absolute 撑高 —— 微信两种内核都认。 */
  height: calc(78vh - 44.8vw - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 var(--sp3);
}

.exrow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.exrow.on {
  background: rgba(232, 238, 220, .5);
}

.exrowl {
  flex: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.exrowcn {
  font-size: var(--fs-body);
}

.exrowen {
  margin-left: 12rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .1em;
  color: var(--muted2);
  text-transform: uppercase;
}

.exrowmeta {
  margin-right: var(--sp2);
  font-size: var(--fs-label);
  color: var(--muted2);
}

.exrowtick {
  width: 48rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--green);
}

.exnone {
  padding: var(--sp3) 0;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.sheetf {
  /* 定高 = 上留白 24 + 按钮 80 + 下留白 24 + 安全区 = 128rpx + safe */
  height: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: var(--sp2) var(--sp3) calc(var(--sp2) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--card);
}

.sheetcount {
  /* 不加 nowrap 的话「已选 0 个」会被挤成两行（数字比中文窄，flex 先压它） */
  flex-shrink: 0;
  white-space: nowrap;
  font-size: var(--fs-note);
  color: var(--muted);
}

.sheetok {
  margin-left: auto;
  height: 80rpx;
  padding: 0 var(--sp4);
  border-radius: 40rpx;
  background: var(--green);
  color: #F6F4EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
}
