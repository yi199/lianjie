/* 动作详情：标题/要点/步骤都在本地字段上，插画和讲解是唯一要等网络的部分 */

/* ---------- 导航 ---------- */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 0;
}

.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h1);
  color: #43473D;
  line-height: 1;
}

.back-hover { background: rgba(31, 35, 28, .06); border-radius: 50%; }

.nav .kicker { margin-left: auto; }

/* ---------- 标题 ---------- */
.exhead { padding-top: 24rpx; }

/* 用 ex- 前缀：组件 set-row 里也有一个 .tag（预览会把组件样式一起注入，会串） */
.ex-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: var(--fs-label);
  letter-spacing: .16em;
  color: var(--muted);
  text-transform: uppercase;
}

.ex-tags .dot { color: var(--muted2); }

.exhead .nm {
  margin-top: var(--sp1);
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -.022em;
  line-height: 1.22;
}

.exhead .en {
  margin-top: 6rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-style: italic;
  font-size: var(--fs-label);
  letter-spacing: 1rpx;
  color: var(--muted2);
}

/* ---------- 插画 / 占位 ---------- */
.artimg {
  display: block;
  width: 100%;
  border-radius: 28rpx;
  background: var(--card);
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: var(--sp3) var(--sp2);
}

.cardlabel {
  font-size: var(--fs-label);
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: var(--sp2);
}

.tipline {
  width: 48rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--clay);
  margin-bottom: var(--sp2);
}

.tipstext {
  font-size: var(--fs-h2);
  font-weight: 600;
  letter-spacing: -.01em;
  line-height: 1.6;
}

/* ---------- 动作档案 ---------- */
.metarow {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.metarow:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.mk {
  width: 160rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  letter-spacing: .1em;
  color: var(--muted);
}

.mv {
  flex: 1;
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--ink);
}
