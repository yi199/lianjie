/* 我的动作：列表 + 编辑表单。颜色/字号全部用 app.wxss 的令牌，不写字面值 */

.page { padding-bottom: calc(var(--sp5) + 40rpx); }

/* ---------- 列表 ---------- */
.rows { border-top: 1px solid var(--line); }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp2) 0;
  border-bottom: 1px solid var(--line);
}

.exmain { flex: 1 1 auto; min-width: 0; }

.exname {
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: -.01em;
}

.exmeta {
  margin-top: 4rpx;
  font-size: var(--fs-note);
  color: var(--muted);
}

.exmeta .dot { margin: 0 6rpx; color: var(--muted2); }

/* 被服务端拒绝的行：标红 + 显示原因，不能静默消失 */
.exerr {
  margin-top: 6rpx;
  font-size: var(--fs-label);
  color: var(--clay);
  line-height: 1.5;
  flex-shrink: 0;
}

.exdel {
  flex-shrink: 0;
  margin-left: var(--sp2);
  padding: 10rpx 18rpx;
  font-size: var(--fs-note);
  color: var(--muted);
  border: 1px solid var(--line);
  border-radius: 999rpx;
}

.exdel-hover { color: var(--clay); border-color: var(--clay); }

/* ---------- 空状态 ---------- */
.empty {
  padding: var(--sp3) 0 var(--sp4);
}

.emptyt {
  font-size: var(--fs-h2);
  font-weight: 600;
  letter-spacing: -.01em;
}

.emptyn {
  margin-top: var(--sp1);
  font-size: var(--fs-note);
  color: var(--muted);
  line-height: 1.7;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: var(--sp3) var(--sp2);
}

.cardlabel {
  font-size: var(--fs-label);
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: var(--sp2);
}

/* ---------- 表单 ---------- */
.field { margin-bottom: var(--sp3); }
.field:last-of-type { margin-bottom: var(--sp2); }

.flabel {
  font-size: var(--fs-note);
  color: var(--muted);
  margin-bottom: var(--sp1);
}

.finput {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 var(--sp2);
  font-size: var(--fs-body);
  color: var(--ink);
  background: rgba(127, 127, 127, .06);
  border-radius: 18rpx;
  box-sizing: border-box;
}

/* ---------- 选择片 ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }

.chip {
  padding: 14rpx 28rpx;
  font-size: var(--fs-note);
  color: var(--muted);
  background: transparent;
  border: 1px solid var(--line);
  border-radius: 999rpx;
}

.chip.on {
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 600;
}

.chip-hover { background: rgba(127, 127, 127, .08); }

/* ---------- 按钮 ---------- */
.formbtns {
  display: flex;
  gap: 16rpx;
  margin-top: var(--sp2);
}

.formbtns .btn {
  flex: 1 1 0;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: var(--fs-body);
}

.btn.ghost {
  color: var(--muted);
  border: 1px solid var(--line);
  background: transparent;
}

.btn.solid {
  color: #FBF8EF;
  background: var(--ink);
}

.btn-hover { opacity: .72; }

.addbtn {
  margin-top: var(--sp3);
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  border: 1px solid var(--ink);
  border-radius: 999rpx;
}

.hint {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  color: var(--muted);
  line-height: 1.7;
}

.about {
  margin-top: var(--sp5);
  font-size: var(--fs-label);
  color: var(--muted2);
  letter-spacing: .04em;
  text-align: center;
}
