<view class="sb" style="height:{{sbh}}px"></view>

<view class="nav">
  <view class="back" bindtap="back" hover-class="back-hover" hover-start-time="0" hover-stay-time="120">
    <text>‹</text>
  </view>
  <text class="kicker">Progress</text>
</view>

<view class="page">

  <view class="phead">
    <view class="brandrow">
      <text class="brand">练界</text>
      <text class="kicker">{{empty ? 'Not Yet' : spanText}}</text>
    </view>
    <view class="h1en">Stronger</view>
    <view class="h1" wx:if="{{!empty}}">你比开始时，强了 {{upText}}%。</view>
    <view class="h1" wx:else>线条还没长出来。</view>
    <view class="sub" wx:if="{{!empty}}">曲线只算正式组，比你练了多少更关心你变强了多少。</view>
    <view class="sub" wx:else>同一个动作练满 3 次，这里就会画出它的坡。</view>
  </view>

  <block wx:if="{{!empty}}">

    <!-- 全身指数 + 周走势 -->
    <view class="hero card">
      <view class="hero-row">
        <view class="hero-main">
          <text class="hero-num num">{{indexText}}</text>
          <text class="hero-unit">× 起点</text>
        </view>
        <view class="hero-side">
          <text class="hero-side-n">{{upText}}%</text>
          <text class="hero-side-d">比第一次</text>
        </view>
      </view>

      <!-- 纯 CSS 柱：柱子顶部越往上，说明那一周整体越强；虚线是起点 1.00 -->
      <view class="chart">
        <view class="base"></view>
        <view class="bars">
          <view class="bar-wrap" wx:for="{{weeks}}" wx:key="week">
            <view class="bar {{item.on ? 'on' : ''}}" style="height:{{item.h}}%"></view>
          </view>
        </view>
      </view>
      <view class="chartlab">
        <text>起点</text>
        <text>{{weeks.length}} 周 → 现在</text>
      </view>
    </view>

    <!-- 各肌群 -->
    <view class="sec">
      <view class="sec-h">哪里变强了</view>
      <view class="parts">
        <view class="part" wx:for="{{parts}}" wx:key="part">
          <text class="part-name">{{item.name}}</text>
          <view class="part-track">
            <view class="part-fill {{item.up ? '' : 'down'}}" style="width:{{item.pct > 100 ? 100 : item.pct}}%"></view>
          </view>
          <text class="part-val {{item.up ? '' : 'down'}}">{{item.up ? '+' : ''}}{{item.delta}}%</text>
        </view>
      </view>
      <view class="note">动作的进步按肌肉参与度分摊：卧推进步，胸算满、三头和前束按比例分。</view>
    </view>

    <!-- 高光 -->
    <view class="sec" wx:if="{{highlights.length}}">
      <view class="sec-h">值得记下来的</view>
      <view class="hl">
        <view class="hl-row" wx:for="{{highlights}}" wx:key="idx">
          <text class="hl-date num">{{item.dateText}}</text>
          <text class="hl-text {{item.kind === 'breakthrough' || item.kind === 'milestone' ? 'warm' : ''}}">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 动作榜 -->
    <view class="sec">
      <view class="sec-h">一个个动作</view>
      <view class="alist">
        <view class="arow" wx:for="{{actions}}" wx:key="exId" data-id="{{item.exId}}" bindtap="toggle"
              hover-class="arow-hover" hover-start-time="0" hover-stay-time="120">
          <view class="atop">
            <text class="aname">{{item.cn}}</text>
            <text class="astatus {{item.status}}">{{item.statusCn}}</text>
            <text class="aidx num">{{item.indexText}}×</text>
          </view>
          <view class="ameta">
            <text>练了 {{item.exposures}} 次</text>
            <text class="dot">·</text>
            <text>{{item.pct > 0 ? '+' : ''}}{{item.pct}}%</text>
            <text class="dot">·</text>
            <text>{{item.modelCn}}</text>
          </view>

          <view class="aopen" wx:if="{{openId === item.exId}}">
            <view class="obars">
              <view class="obar" wx:for="{{openSeries}}" wx:for-item="s" wx:key="date">
                <text class="obar-v num">{{s.value}}</text>
                <view class="obar-track">
                  <view class="obar-fill" style="height:{{s.h}}%"></view>
                </view>
                <text class="obar-d">{{s.date}}</text>
              </view>
            </view>
            <view class="ostall" wx:if="{{openStall}}">{{openStall}}</view>
            <view class="ohint" wx:else>这是这个动作最近几次的力量值（{{openModel}}）</view>
          </view>
        </view>
      </view>
    </view>

    <view class="foot" wx:if="{{demo}}">现在看到的是示例数据。你自己的记录练满 3 次之后，这里就换成你的。</view>
    <view class="foot" wx:else>只算正式组。热身组和示例数据都不进曲线。</view>

  </block>

  <!-- 空态 -->
  <view class="sec" wx:if="{{empty}}">
    <view class="card">
      <view class="empty-t">还差几次训练</view>
      <view class="empty-n">练满 3 次的动作才会画曲线。现在已经练过的：</view>
      <view class="elist">
        <view class="erow" wx:for="{{actions}}" wx:key="exId">
          <text class="ename">{{item.cn}}</text>
          <text class="eneed">{{item.exposures}} / 3 次</text>
        </view>
      </view>
    </view>
  </view>

</view>
