/* ================= 力量地形 ================= */

.terrain-wrap {
  margin-top: var(--sp2);
  width: 100%;
}

.terrain {
  width: 100%;
  height: 300rpx;
  display: block;
}

.terr-cap {
  margin-bottom: 2rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  color: var(--muted2);
  letter-spacing: .04em;
}

.terr-lab {
  display: flex;
  justify-content: space-between;
  margin-top: var(--sp1);
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  color: var(--muted2);
}

/* ================= 三个数字卡 ================= */

.cards3 {
  margin-top: var(--sp3);
  display: flex;
}

.cc {
  flex: 1;
  margin-right: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: #F6F4EA;
  border: 1rpx solid rgba(223, 220, 206, .8);
  display: flex;
  flex-direction: column;
}

.cc:last-child {
  margin-right: 0;
}

.cc .t {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .1em;
  color: var(--muted2);
}

.cc .v {
  margin-top: 10rpx;
  font-size: 38rpx;
  line-height: 1.1;
  color: var(--ink);
}

.cc .d {
  margin-top: 6rpx;
  font-size: var(--fs-label);
  color: var(--clay);
}

/* ================= 评语 ================= */

.comment {
  margin-top: var(--sp3);
  font-size: var(--fs-note);
  line-height: 1.9;
  color: var(--muted);
}

/* ================= 用力分布 ================= */

.prow {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp2);
}

.pnm {
  width: 92rpx;
  flex-shrink: 0;
  font-size: var(--fs-note);
  color: var(--muted);
}

.pbw {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
  background: #E6E3D5;
  overflow: hidden;
}

.pbf {
  height: 100%;
  border-radius: 5rpx;
  background: var(--green);
  transition: width .6s cubic-bezier(.2, .8, .3, 1);
}

.ppc {
  width: 92rpx;
  text-align: right;
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 日历 ================= */

.grid {
  display: flex;
  flex-wrap: wrap;
}

.wd {
  width: 14.28%;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--muted2);
  padding-bottom: var(--sp2);
}

.cell {
  width: 14.28%;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cd {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  color: var(--muted);
}

.cell.on .cd {
  background: var(--green);
  color: #F6F4EA;
}

/* 有记录的日子按下：圆圈压深一档 + 微微缩小，和卡片同一套手感 */
.cellh .cd {
  background: #2C3826;
  transform: scale(.94);
  transition: background .12s, transform .12s cubic-bezier(.2, .8, .2, 1);
}

.cell.today .cd {
  border: 1rpx solid var(--clay);
  color: var(--clay);
}

.cell.on.today .cd {
  border-color: transparent;
  color: #F6F4EA;
}

.legend {
  margin-top: var(--sp2);
  display: flex;
  align-items: center;
}

.lgdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--green);
  margin-right: var(--sp1);
}

.lgtext {
  font-size: var(--fs-label);
  color: var(--muted2);
}

/* ================= 动作频次 ================= */

.arow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.an {
  width: 48rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--muted2);
}

.acn {
  flex: 1;
  font-size: var(--fs-body);
}

.act {
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ================= 空态 ================= */

.emptycard {
  padding: var(--sp4) var(--sp3);
  border-radius: 40rpx;
  background: var(--card);
  text-align: center;
}

.etitle {
  font-size: var(--fs-h2);
  line-height: 1.4;
}

.etext {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.8;
  color: var(--muted);
}

.ebtn {
  margin-top: var(--sp3);
  font-size: var(--fs-body);
  color: var(--green);
}

.ebtn.ghost {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* 自定义 tabBar 是固定定位的：页面自己让出它的高度（108rpx + 安全区），否则最后一行被盖住 */
.page { padding-bottom: calc(var(--sp5) + 104rpx + env(safe-area-inset-bottom)); }

/* ================= 进步入口 ================= */

.gocard {
  display: flex;
  align-items: center;
  gap: var(--sp2);
  margin-top: var(--sp3);
  padding: 24rpx var(--sp2);
  border-radius: 24rpx;
  background: #F6F4EA;
  border: 1rpx solid rgba(223, 220, 206, .8);
}

.gocard-hover {
  background: var(--card-press);
  transform: translateY(1rpx);
}

.gotext { flex: 1 1 auto; min-width: 0; }

.golead {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: -.01em;
  color: var(--ink);
}

.gosub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-label);
  letter-spacing: .04em;
  color: var(--muted);
}

.goarrow {
  flex-shrink: 0;
  font-size: var(--fs-h2);
  color: var(--clay);
}
