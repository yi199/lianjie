/* ================= 三个数 ================= */

.stats {
  display: flex;
  align-items: flex-end;
}

.st {
  margin-right: var(--sp4);
  display: flex;
  flex-direction: column;
}

.st:last-child {
  margin-right: 0;
}

.v {
  font-size: var(--fs-h1);
  line-height: 1;
  color: var(--ink);
}

.k {
  margin-top: var(--sp1);
  font-size: var(--fs-label);
  letter-spacing: .06em;
  color: var(--muted2);
}

/* ================= 日历 ================= */

.grid {
  display: flex;
  flex-wrap: wrap;
}

.wd {
  width: 14.28%;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--muted2);
  padding-bottom: var(--sp2);
}

.cell {
  width: 14.28%;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cd {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Georgia, serif;
  font-size: var(--fs-note);
  color: var(--muted);
}

.cell.on .cd {
  background: var(--green);
  color: #F6F4EA;
}

.cell.today .cd {
  border: 1rpx solid var(--clay);
  color: var(--clay);
}

.cell.on.today .cd {
  border-color: transparent;
  color: #F6F4EA;
}

.legend {
  margin-top: var(--sp2);
  display: flex;
  align-items: center;
}

.lgdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--green);
  margin-right: var(--sp1);
}

.lgtext {
  font-size: var(--fs-label);
  color: var(--muted2);
}

/* ================= 部位 ================= */

.prow {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp2);
}

.pnm {
  width: 92rpx;
  flex-shrink: 0;
  font-size: var(--fs-note);
  color: var(--muted);
}

.pbw {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
  background: #E6E3D5;
  overflow: hidden;
}

.pbf {
  height: 100%;
  border-radius: 5rpx;
  background: var(--green);
}

.ppc {
  width: 92rpx;
  text-align: right;
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 动作频次 ================= */

.arow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.an {
  width: 48rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--muted2);
}

.acn {
  flex: 1;
  font-size: var(--fs-body);
}

.act {
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ================= 空态 ================= */

.emptycard {
  padding: var(--sp4) var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  text-align: center;
}

.etitle {
  font-size: var(--fs-h2);
  line-height: 1.4;
}

.etext {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.8;
  color: var(--muted);
}

.ebtn {
  margin-top: var(--sp3);
  font-size: var(--fs-body);
  color: var(--green);
}

.ebtn.ghost {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 力量地形 ================= */

.terrain-wrap {
  margin-top: var(--sp2);
  width: 100%;
  height: 440rpx;
}

.terrain {
  width: 100%;
  height: 440rpx;
}

.legend2 {
  margin-top: var(--sp2);
  display: flex;
  flex-wrap: wrap;
}

.lg {
  width: 33.33%;
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.lgd {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #DCD8C8;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.lgd.on {
  background: var(--green);
}

.lgn {
  font-size: var(--fs-note);
  color: var(--muted);
}

.lgp {
  margin-left: auto;
  padding-right: 20rpx;
  font-size: var(--fs-label);
  color: var(--muted2);
}

/* ================= 周训练量 ================= */

.bars {
  margin-top: var(--sp2);
  height: 260rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  flex: 1;
  position: relative;
  height: 100%;
}

.barfill {
  position: absolute;
  left: 50%;
  margin-left: -11rpx;
  bottom: 30rpx;
  width: 22rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #E2DFD1;
  transition: height .5s cubic-bezier(.2, .8, .2, 1);
}

.barfill.on {
  background: var(--green);
}

.barl {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--muted2);
}

.barnote {
  margin-top: var(--sp1);
  font-size: var(--fs-label);
  color: var(--muted2);
}
