<view class="sb" style="height:{{sbh + 12}}px"></view>

<view class="page {{fx}}">

  <view class="phead">
    <view class="brandrow">
      <text class="brand">力见</text>
      <text class="kick">This Month · {{monthLabel}}</text>
    </view>
    <view class="h1en">Your Terrain</view>
    <view class="h1">{{empty ? '地形还没长出来。' : '你练出来的地形。'}}</view>
    <view class="sub" wx:if="{{!empty}}">每一座山，是一次训练。</view>
  </view>

  <!-- 示例数据提示：混在统计里必须说清楚，否则分不清哪条是自己练的 -->
  <view class="demobar" wx:if="{{hasDemo}}">
    <text class="dbt">现在混着示例数据，只用于看图表效果</text>
    <text class="dbb" bindtap="clearDemo" hover-class="dbb-hover" hover-start-time="0" hover-stay-time="120">清除</text>
  </view>

  <!-- 进步：从「练了多少」走到「强了多少」 -->
  <view class="gocard" bindtap="gotoProgress" hover-class="gocard-hover" hover-start-time="0" hover-stay-time="120">
    <view class="gotext">
      <text class="golead">比开始时，强了多少</text>
      <text class="gosub">每个动作的坡 · 卡住的地方 · 值得记的一刻</text>
    </view>
    <text class="goarrow">→</text>
  </view>

  <block wx:if="{{!empty}}">

    <!-- 山脊线：12 周，每周一个峰，本周是陶土色那个点；左边三档刻度 -->
    <view class="terrain-wrap">
      <canvas type="2d" id="terrain" class="terrain"></canvas>
      <view class="terr-lab">
        <text>12 周前</text>
        <text>本周</text>
      </view>
    </view>

    <!-- 三个数字卡 -->
    <view class="cards3">
      <view class="cc">
        <text class="t">TOTAL</text>
        <text class="v num">{{totalShown}}</text>
        <text class="d">{{hasTon ? '吨 · 负重累计' : '组 · 累计'}}</text>
      </view>
      <view class="cc">
        <text class="t">BEST</text>
        <text class="v num">{{bestShown}}</text>
        <text class="d">{{amountUnit}} · 单次最高</text>
      </view>
      <view class="cc">
        <text class="t">DAYS</text>
        <text class="v num">{{totalDays}}</text>
        <text class="d">天 · 练过</text>
      </view>
    </view>

    <!-- 用力分布 -->
    <view class="sec" wx:if="{{parts.length}}">
      <view class="sec-h">这个月，你的用力分布</view>
      <view class="prow" wx:for="{{parts}}" wx:key="key">
        <text class="pnm">{{item.name}}</text>
        <view class="pbw"><view class="pbf" style="width:{{item.pct}}%"></view></view>
        <text class="ppc num">{{item.pct}}%</text>
      </view>
    </view>

    <view class="comment">{{comment}}</view>

    <!-- 日历热力图 -->
    <view class="sec">
      <view class="sec-h">这个月，哪天练过</view>
      <view class="grid">
        <view class="wd" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
        <view class="cell blank" wx:for="{{blanks}}" wx:key="*this"></view>
        <view
          class="cell {{item.on ? 'on' : ''}} {{item.today ? 'today' : ''}}"
          wx:for="{{cells}}"
          wx:key="d"
          data-date="{{item.date}}"
          data-on="{{item.on}}"
          bindtap="openDay"
          hover-class="{{item.on ? 'cellh' : 'none'}}"
          hover-start-time="0"
          hover-stay-time="120"
        >
          <view class="cd">{{item.d}}</view>
        </view>
      </view>
      <view class="legend">
        <text class="lgdot"></text>
        <text class="lgtext">深色 = 练过</text>
      </view>
    </view>

    <!-- 动作频次 -->
    <view class="sec" wx:if="{{top.length}}">
      <view class="sec-h">练得最多的动作</view>
      <view class="arow" wx:for="{{top}}" wx:key="cn">
        <text class="an num">{{index + 1}}</text>
        <text class="acn">{{item.cn}}</text>
        <text class="act num">{{item.count}} 次</text>
      </view>
    </view>

  </block>

  <!-- 空态 -->
  <block wx:else>
    <view class="emptycard sec">
      <view class="etitle">练一次，地形就长出来一点。</view>
      <view class="etext">每一周是一个峰。练得多的那周，山就高一些；休息的那周，是一条谷。</view>
      <view class="ebtn" bindtap="gotoToday">去训练 →</view>
    </view>
  </block>

</view>
