<view class="sb" style="height:{{sbh}}px"></view>

<view class="nav">
  <view class="back" bindtap="back" hover-class="back-hover">
    <text>‹</text>
  </view>
  <view class="tt">
    <text>{{planName}}</text>
    <text class="en">第 {{pnum}} 个动作 / 共 {{total}} 个</text>
  </view>
</view>

<view class="prog">
  <text class="pn">{{pnum}}</text>
  <text class="pt">/ {{total}}</text>
  <view class="pbar"><view class="pfill" style="width:{{pct}}%"></view></view>
</view>

<view class="wrap">
  <view class="exhead">
    <view class="exmain">
      <view class="nm">{{ex.cn}}</view>
      <view class="en">{{ex.en}}</view>
    </view>
    <view class="swap" bindtap="changeEx" hover-class="swap-hover">换一个</view>
  </view>

  <view class="last" wx:if="{{ex.swapped}}">已换成 {{ex.cn}} · 原动作 {{ex.originCn}}</view>
  <view class="last" wx:if="{{lastText}}">{{lastText}}</view>
  <view class="sug" wx:if="{{sugHint}}">{{sugHint}}</view>

  <!-- 杠铃片：一组一片，完成的点亮；超过历史最好成绩的那组是陶土色 -->
  <view class="plates">
    <view
      class="plate {{item.on ? 'on' : ''}} {{item.pr ? 'pr' : ''}}"
      wx:for="{{plates}}"
      wx:key="no"
    ></view>
    <text class="plate-ct">{{sets.length}} 组</text>
  </view>

  <view class="sets">
    <set-row
      wx:for="{{sets}}"
      wx:key="no"
      no="{{item.no}}"
      weight="{{item.weight}}"
      reps="{{item.reps}}"
      unit="{{item.unit}}"
      done="{{item.done}}"
      pr="{{item.pr}}"
      bind:toggle="onToggle"
      bind:weightchange="onWeightChange"
      bind:repschange="onRepsChange"
    />
    <view class="addset" bindtap="addSet">＋ 加一组</view>
  </view>

  <!-- 组间休息：呼吸环 -->
  <view class="rest" wx:if="{{resting}}">
    <view class="breath">
      <view class="ring" style="background: conic-gradient(#3C4A32 {{restPct}}%, #E4E1D3 0)"></view>
      <view class="core">
        <text class="tm">{{restText}}</text>
        <text class="ph">{{restPhase}}</text>
      </view>
    </view>
    <text class="sk" bindtap="stopRest">跳过休息</text>
  </view>
</view>

<view class="footbar">
  <view class="btn" hover-class="btn-hover" bindtap="nextEx">
    {{isLast ? '完成训练 →' : '完成 · 下一个动作 →'}}
  </view>
</view>
