.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 0;
}
.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #43473D;
  line-height: 1;
  margin-left: -12rpx;
}
.back-hover { opacity: .5; }
.nav .tt {
  font-size: 28rpx;
}
.nav .en {
  display: block;
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 18rpx;
  color: var(--muted2);
  margin-top: 4rpx;
}

/* 进度 */
.prog {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 44rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}
.prog .pn {
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: var(--ink);
}
.pbar {
  flex: 1;
  height: 4rpx;
  background: #DDDACB;
  position: relative;
  margin-left: 8rpx;
}
.pfill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--ink);
  transition: width .3s;
}

/* 动作区 */
.wrap { padding: 0 44rpx; }

.exhead {
  padding-top: 36rpx;
  display: flex;
  align-items: flex-start;
}

.exmain {
  flex: 1;
}

.exhead .nm {
  font-size: 50rpx;
  letter-spacing: .02em;
}

.exhead .en {
  margin-top: 8rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--muted2, #A9A79A);
}

.swap {
  flex-shrink: 0;
  margin-top: 14rpx;
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--line, #DFDCCE);
  border-radius: 30rpx;
  font-size: 21rpx;
  color: var(--muted, #7C8A70);
}

.swap-hover {
  background: #EFF2E7;
}

.last {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--muted2, #A9A79A);
}

.sug {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--clay, #B4795A);
}

.sets {
  margin-top: 30rpx;
  border-top: 1rpx solid var(--line);
}
.addset {
  padding: 26rpx 0;
  font-size: 23rpx;
  color: var(--muted);
}

/* 休息条 */
/* ---------------- 杠铃片 ---------------- */

.plates {
  margin: 30rpx 0 4rpx;
  display: flex;
  align-items: flex-end;
}

.plate {
  width: 18rpx;
  height: 46rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: #E4E1D3;
  transition: background .3s, transform .3s;
}

.plate.on {
  background: var(--green, #3C4A32);
  transform: translateY(-6rpx);
}

.plate.pr {
  background: var(--clay, #B4795A);
}

.plate-ct {
  margin-left: 12rpx;
  align-self: center;
  font-size: 20rpx;
  color: var(--muted2, #A9A79A);
}

/* ---------------- 组间休息：呼吸环 ---------------- */

.rest {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.breath {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  /* 兜底：老基础库不支持 conic-gradient 时显示成纯色环，不会崩 */
  background: #E4E1D3;
  transition: background .95s linear;
}

/* 挖空中间，让外圈只剩一圈进度 */
.ring::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border-radius: 50%;
  background: var(--bg, #F2F0E6);
}

.core {
  position: relative;
  z-index: 2;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #EFF2E7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: breathe 8s ease-in-out infinite;
}

.core .tm {
  font-family: Georgia, serif;
  font-size: 48rpx;
  color: var(--green, #3C4A32);
  line-height: 1;
}

.core .ph {
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--muted2, #A9A79A);
}

.sk {
  margin-top: 28rpx;
  font-size: 21rpx;
  color: var(--muted2, #A9A79A);
  text-decoration: underline;
}

/* 4 秒吸、4 秒呼 */
@keyframes breathe {
  0%   { transform: scale(.86); }
  50%  { transform: scale(1.04); }
  100% { transform: scale(.86); }
}
