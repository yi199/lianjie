.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 0;
}
.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h1);
  color: #43473D;
  line-height: 1;
  margin-left: -12rpx;
}
.back-hover { background: rgba(31, 35, 28, .06); border-radius: 50%; }
.nav .tt {
  flex: 1;
  font-size: var(--fs-note);
}
.nav .en {
  display: block;
  font-family: 'LJGrotesk', sans-serif;
  font-style: italic;
  font-size: var(--fs-label);
  color: var(--muted2);
  margin-top: 4rpx;
}

.swap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  min-height: 64rpx;          /* 触摸目标别只有一行字那么高 */
  padding: 0 26rpx;
  border: 1rpx solid var(--line, #DFDCCE);
  border-radius: 30rpx;
  font-size: var(--fs-label);
  color: var(--muted, #8B897C);
}
.swap-hover { background: var(--card-press); transform: translateY(1rpx) scale(.996); }

.wrap {
  padding: 0 44rpx 220rpx;
}

/* ---------------- 动作名 ---------------- */

.exhead {
  padding-top: 24rpx;
}
.exhead .nm {
  font-size: var(--fs-h1);
  letter-spacing: .02em;
  line-height: 1.2;
}
/* 动作名 + 「看讲解」入口：名字可以换行，「看讲解」永远贴右边 */
.namerow {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.namerow .nm { flex: 0 1 auto; min-width: 0; }
.detail {
  margin-left: auto;
  flex-shrink: 0;
  padding: 6rpx 0;
  font-size: var(--fs-label);
  letter-spacing: .1em;
  color: var(--muted2);
}
.detail-hover { color: var(--clay); }
.exhead .en {
  margin-top: 6rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-style: italic;
  font-size: var(--fs-label);
  letter-spacing: 1rpx;
  color: var(--muted2);
}
/* 英文名 + 「换一个」同一行：英文名贴左，按钮贴右。
   这一行在胶囊下方，所以按钮能被点到（顶行放不得，见 wxml 里的注释） */
.subrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.swapped {
  margin-top: 12rpx;
  font-size: var(--fs-label);
  color: var(--clay);
}

/* ---------------- 杠铃 ---------------- */

.barbell {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 34rpx 0 6rpx;
}

.side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
/* i=0 最靠近套筒：左侧反着排，右侧正着排，两侧才对称 */
.side.left { flex-direction: row-reverse; }
.side.right { flex-direction: row; }

.plate {
  width: 20rpx;
  height: 96rpx;
  margin: 0 4rpx;
  border-radius: 6rpx;
  background: #DCD8C8;
  /* 点亮只靠 class 切换 + CSS transition，不用 setData 驱动动画 */
  transition: background-color .5s ease, transform .42s cubic-bezier(.2, 1.4, .4, 1);
}
.plate.on {
  background: var(--green);
}
.plate.pr {
  background: var(--clay);
}

.bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--green);
  transition: background-color .5s ease;
}

/* ---------------- 大数字 ---------------- */

.bignum {
  margin-top: 18rpx;
  text-align: center;
  line-height: 1;
}
.bignum .n {
  font-family: 'LJGrotesk', sans-serif;
  font-size: 114rpx;
  color: var(--ink);
  letter-spacing: -.02em;
}
.bignum .u {
  font-size: var(--fs-note);
  color: var(--muted2);
  margin-left: 12rpx;
}

/* ---------------- 组进度点 ---------------- */

.dots {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 7rpx;
  border-radius: 50%;
  background: #DCD8C8;
  transition: background-color .3s;
}
.dot.on { background: var(--green); }
.dot.pr { background: var(--clay); }

.hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--muted2);
}
.sug {
  margin-top: 8rpx;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--clay);
}

/* ---------------- 信息表 ---------------- */

.facts {
  margin-top: 34rpx;
  border-top: 1rpx solid var(--line);
}
.facts .f {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.facts .k {
  flex-shrink: 0;
  font-size: var(--fs-note);
  color: var(--muted);
  margin-right: 32rpx;
}
.facts .v {
  flex: 1;
  font-size: var(--fs-note);
  color: var(--ink);
  text-align: right;
}

/* ---------------- 组记录 ---------------- */

.sets {
  margin-top: 30rpx;
}
.sh {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: var(--fs-note);
  color: var(--muted2);
  letter-spacing: .04em;
  padding-bottom: 6rpx;
}
.shnote {
  font-size: var(--fs-label);
}
.addset {
  padding: 26rpx 0 10rpx;
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ---------------- 组间休息：呼吸环（盖住整页） ---------------- */

.rest {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(242, 240, 230, .985);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 140rpx;
}

.rtitle {
  font-size: var(--fs-note);
  color: var(--muted);
  letter-spacing: .08em;
  margin-bottom: 64rpx;
}

.breath {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  /* 兜底：老基础库不支持 conic-gradient 时是个纯色块，不会崩 */
  background: #DCD8C8;
  transition: background .95s linear;
}

/* 挖空中间，外圈只剩一道细环 */
.ring::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  right: 5rpx;
  bottom: 5rpx;
  border-radius: 50%;
  background: var(--bg);
}

/* 随呼吸放大的柔光 */
.glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(60, 74, 50, .16) 0%,
    rgba(60, 74, 50, .05) 55%,
    rgba(60, 74, 50, 0) 72%);
  animation: breathe 9s ease-in-out infinite;
}

.core {
  position: relative;
  z-index: 2;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(238, 242, 228, .92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: breathe 9s ease-in-out infinite;
}
.core .tm {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-title);
  color: var(--green);
  line-height: 1;
}
.core .ph {
  margin-top: 10rpx;
  font-size: var(--fs-label);
  letter-spacing: 4rpx;
  color: var(--muted);
}

.rsub {
  margin-top: 72rpx;
  font-size: var(--fs-note);
  color: var(--muted);
}
.sk {
  margin-top: 28rpx;
  font-size: var(--fs-label);
  color: var(--muted2);
  text-decoration: underline;
}

/* 吸 4 秒、呼 5 秒 = 9 秒一个周期 */
@keyframes breathe {
  0%   { transform: scale(.82); }
  55%  { transform: scale(1.06); }
  100% { transform: scale(.82); }
}

/* 主按钮常驻底部：set-row 列表再长也不会把「完成这组」挤走 */
.footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 72%, rgba(242, 240, 230, 0));
}
