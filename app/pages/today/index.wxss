/* ================= 本周进度 ================= */

/* 中文日期不能用 .kicker（那是给英文的 0.26em 字距，中文会被拉散） */
.date {
  margin-left: auto;
  font-size: var(--fs-label);
  letter-spacing: .06em;
  color: var(--muted2);
}

.weekbar {
  margin-top: var(--sp3);
  display: flex;
  align-items: center;
}

.wdots {
  display: flex;
  align-items: center;
}

.wdot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #DEDBCB;
  transition: background .25s;
}

.wdot.on {
  background: var(--green);
}

.wtext {
  margin-left: 10rpx;
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ================= 今天练什么：大白卡 =================
   结构照杯间餐时的酒谱卡片：上方大片留白，内容压在底部。
   那个留白不是空的，它让下面的标题显得贵重。
*/

.card {
  position: relative;
  padding: var(--sp3) 36rpx 36rpx;
  border-radius: 40rpx;
  background: var(--card);
  overflow: hidden;
}

/* 卡片主视觉：手绘线稿（自己画的，无版权问题）
   放在卡片中上部，内容压在它下面 */
.cart {
  position: absolute;
  left: 50%;
  top: 36rpx;
  width: 320rpx;
  margin-left: -160rpx;
}

.cbody {
  position: relative;
  padding-top: 336rpx;      /* 上方留白：给线稿让位，也让标题显得贵重 */
}

.cen {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .26em;
  color: var(--muted2);
  text-transform: uppercase;
}

.cname {
  margin-top: var(--sp1);
  font-size: var(--fs-title);
  line-height: 1.15;
  letter-spacing: .01em;
}

.cmeta {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  color: var(--muted);
  line-height: 1.6;
}

.cmeta.dim {
  margin-top: 6rpx;
  color: var(--muted2);
}

/* 主按钮：浅色胶囊，文字左、箭头右（和「翻开手册 →」一样的排法） */
.cbtn {
  margin-top: var(--sp3);
  height: 100rpx;
  padding: 0 36rpx;
  border-radius: 50rpx;
  background: #F7F6EE;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-body);
  color: var(--ink);
}

.cbtn-hover {
  background: var(--soft);
}

.carrow {
  font-family: 'LJGrotesk', sans-serif;
  color: var(--muted);
}

/* ================= 动作清单 ================= */

.plist {
  border-top: 1rpx solid var(--line);
}

.pitem {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.pitem-hover {
  background: var(--card);
}

.pno {
  width: 48rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--muted2);
}

.pnm {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pcn {
  font-size: var(--fs-body);
  color: var(--ink);
}

.pen {
  margin-top: 4rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .08em;
  color: var(--muted2);
}

.pss {
  flex-shrink: 0;          /* 换字体后 Space Grotesk 的数字更宽，不加这条「4 × 10」会被挤成两行 */
  white-space: nowrap;
  font-size: var(--fs-note);
  color: var(--muted);
}

.tick {
  margin-left: 16rpx;
  font-size: var(--fs-note);
  color: var(--green);
}

/* ================= 提示与空态 ================= */

.tip {
  margin-top: var(--sp3);
  padding: var(--sp2);
  border-radius: 22rpx;
  background: var(--soft);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: #6F7D63;
}

/* 换方案：一行小链接，不抢主按钮的位置 */
.swapline {
  margin-top: var(--sp2);
  padding: 20rpx var(--sp2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--fs-note);
  color: var(--green);
  border-bottom: 1rpx solid var(--line);
}

.swapline-hover {
  opacity: .7;
}

.swaparrow {
  font-family: 'LJGrotesk', sans-serif;
  opacity: .7;
}

.emptycard {
  padding: var(--sp4) var(--sp3);
  border-radius: 40rpx;
  background: var(--card);
  text-align: center;
}

.etitle {
  font-size: var(--fs-h2);
}

.etext {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted);
}

.ebtn {
  margin-top: var(--sp3);
  height: 92rpx;
  border-radius: 46rpx;
  background: #F7F6EE;
  border: 1rpx solid var(--line);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
}

.ebtn-hover {
  background: var(--soft);
}
