/* ================= 本周进度 ================= */

.weekbar {
  margin-top: var(--sp3);
  display: flex;
  align-items: center;
}

.wdots {
  display: flex;
  align-items: center;
}

.wdot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #E2DFD1;
  transition: background .25s;
}

.wdot.on {
  background: var(--green);
}

.wtext {
  margin-left: 10rpx;
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ================= 今天是哪一天 ================= */

.card {
  padding: var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.cardtop {
  display: flex;
  align-items: baseline;
}

.ckey {
  font-family: Georgia, serif;
  font-size: var(--fs-h2);
  color: var(--clay);
}

.cen {
  margin-left: 16rpx;
  font-family: Georgia, serif;
  font-size: var(--fs-label);
  letter-spacing: .26em;
  color: var(--muted2);
  text-transform: uppercase;
}

.cname {
  margin-top: var(--sp2);
  font-size: var(--fs-title);
  line-height: 1.2;
  letter-spacing: .01em;
}

.cmeta {
  margin-top: var(--sp1);
  font-size: var(--fs-note);
  color: var(--muted);
  line-height: 1.6;
}

.cmeta.dim {
  color: var(--muted2);
}

/* ================= 动作清单 ================= */

.plist {
  border-top: 1rpx solid var(--line);
}

.pitem {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.pitem-hover {
  background: var(--card);
}

.pno {
  width: 48rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--muted2);
}

.pnm {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pcn {
  font-size: var(--fs-body);
  color: var(--ink);
}

.pen {
  margin-top: 4rpx;
  font-family: Georgia, serif;
  font-size: var(--fs-label);
  letter-spacing: .08em;
  color: var(--muted2);
}

.pss {
  font-size: var(--fs-note);
  color: var(--muted);
}

.tick {
  margin-left: 16rpx;
  font-size: var(--fs-note);
  color: var(--green);
}

/* ================= 提示与空态 ================= */

.tip {
  margin-top: var(--sp3);
  padding: var(--sp2) var(--sp2);
  border-radius: 22rpx;
  background: var(--soft);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: #6F7D63;
}

.emptycard {
  padding: var(--sp4) var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  text-align: center;
}

.etitle {
  font-size: var(--fs-h2);
}

.etext {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted);
}

/* 卡里的主行动：首屏就能点到，不用滚到底部找按钮 */
.cbtn {
  margin-top: var(--sp3);
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--green);
  color: #F6F4EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  letter-spacing: .08em;
}

.cbtn-hover {
  opacity: .9;
  transform: scale(.99);
}

.ebtn {
  margin-top: var(--sp3);
  height: 92rpx;
  border-radius: 46rpx;
  border: 1rpx solid var(--green);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
}

.ebtn-hover {
  background: var(--soft);
}
