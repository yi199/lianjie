<view class="sb" style="height:{{sbh + 36}}px"></view>

<view class="wrap">
  <view class="kicker">Today · {{weekday}}</view>
  <view class="h1">今天练什么。</view>

  <!-- 训练日 -->
  <block wx:if="{{!plan.rest}}">
    <view class="todaybig">
      <view class="day">{{plan.en}}</view>
      <view class="tt">{{plan.name}}</view>
      <view class="meta">{{items.length}} 个动作 · 约 45 分钟</view>
      <view class="last">{{lastText}}</view>
    </view>

    <view class="plist">
      <view class="ph">动作清单</view>
      <view class="pitem" wx:for="{{items}}" wx:key="exId">
        <text class="no">{{item.no}}</text>
        <view class="nm">
          <text>{{item.cn}}</text>
          <text class="en">{{item.en}}</text>
        </view>
        <text class="ss">{{item.label}}</text>
        <text class="tick" wx:if="{{item.done}}">✓</text>
      </view>
    </view>
  </block>

  <!-- 休息日 -->
  <block wx:else>
    <view class="restcard">
      <view class="rtitle">今天休息。</view>
      <view class="rdesc">肌肉是在休息的时候长的，别急。</view>
      <view class="rlink" bindtap="gotoStats">看看这个月的记录 →</view>
    </view>
  </block>
</view>

<view class="footbar">
  <view wx:if="{{!plan.rest}}" class="btn" hover-class="btn-hover" bindtap="start">开始训练 →</view>
  <view wx:else class="btn btn-ghost" hover-class="btn-hover" bindtap="gotoStats">去看数据</view>
</view>
