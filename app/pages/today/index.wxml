<view class="sb" style="height:{{sbh + 12}}px"></view>

<view class="page {{fx}}">

  <view class="phead">
    <view class="brandrow">
      <text class="brand">练界</text>
      <text class="date">{{weekday}} · {{dateText}}</text>
    </view>
    <view class="h1en">Today's Session</view>
    <view class="h1">{{h1}}</view>
  </view>

  <!-- 本周进度：练了就算一次，不绑星期几 -->
  <view class="weekbar">
    <view class="wdots">
      <view class="wdot {{index < weekDone ? 'on' : ''}}" wx:for="{{weekDots}}" wx:key="*this"></view>
    </view>
    <text class="wtext">本周 {{weekDone}} / {{weekTarget}}</text>
  </view>

  <block wx:if="{{plan}}">

    <!-- 今天练什么：一张大白卡，上方留白，内容压在底部 -->
    <view class="card sec">
      <image class="cart" src="/images/art/{{art}}.png" mode="widthFix" />

      <view class="cbody">
        <view class="cen">{{plan.en}}</view>
        <view class="cname">{{plan.name}}</view>
        <view class="cmeta">{{items.length}} 个动作 · 约 {{minutes}} 分钟</view>
        <view class="cmeta dim">{{lastText}}</view>

        <view class="cbtn" hover-class="cbtn-hover" bindtap="mainAction">
          <text>{{allDone ? '看今日战报' : (resumed ? '继续训练' : '开始训练')}}</text>
          <text class="carrow">→</text>
        </view>
      </view>
    </view>

    <!-- 动作清单：点某个动作直接跳过去 -->
    <view class="sec">
      <view class="sec-h">动作清单</view>
      <view class="plist">
        <view
          class="pitem"
          wx:for="{{items}}"
          wx:key="exId"
          bindtap="openEx"
          data-i="{{index}}"
          hover-class="pitem-hover"
        >
          <text class="pno num">{{item.no}}</text>
          <view class="pnm">
            <text class="pcn">{{item.cn}}</text>
            <text class="pen">{{item.en}}</text>
          </view>
          <text class="pss num">{{item.label}}</text>
          <text class="tick" wx:if="{{item.done}}">✓</text>
        </view>
      </view>
    </view>

    <view class="tip">{{tip}}</view>

    <view class="swapline" hover-class="swapline-hover" bindtap="gotoPrograms">
      <text>换方案 / 自己搭训练安排</text>
      <text class="swaparrow">→</text>
    </view>

  </block>

  <block wx:else>
    <view class="emptycard sec">
      <view class="etitle">还没有训练计划</view>
      <view class="etext">回到引导页重新选一次，30 秒就好。</view>
      <view class="ebtn" hover-class="ebtn-hover" bindtap="gotoMy">去设置 →</view>
    </view>
  </block>

</view>
