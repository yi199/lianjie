/* ================= 当前计划 ================= */

.card {
  padding: var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.cardlabel {
  font-size: var(--fs-label);
  letter-spacing: .2em;
  color: var(--muted2);
  text-transform: uppercase;
}

.cname {
  margin-top: var(--sp2);
  font-size: var(--fs-h2);
  line-height: 1.3;
}

.planline {
  margin-top: var(--sp2);
  display: flex;
  flex-wrap: wrap;
}

.pk {
  margin-right: var(--sp3);
  margin-top: var(--sp1);
  display: flex;
  align-items: baseline;
}

.pkkey {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  color: var(--clay);
  margin-right: 8rpx;
}

.pkname {
  font-size: var(--fs-note);
  color: var(--muted);
}

.changebtn {
  margin-top: var(--sp3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--sp3);
  border-radius: 44rpx;
  background: var(--soft);
  color: var(--green);
  font-size: var(--fs-note);
  letter-spacing: .06em;
}

.changebtn-hover {
  opacity: .9;
}

.changearrow {
  font-family: 'LJGrotesk', sans-serif;
}

/* ================= 选项 ================= */

.chips {
  display: flex;
}

.chip {
  flex: 1;
  height: 88rpx;
  margin-right: var(--sp2);
  border-radius: 44rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--muted);
  transition: background .15s, color .15s, border-color .15s;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: var(--green);
  border-color: var(--green);
  color: #F6F4EA;
}

.hint {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted2);
}

/* ================= 列表行 ================= */

.rows {
  border-top: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row-hover {
  background: var(--card);
}

.rowt {
  font-size: var(--fs-body);
}

.rowt.danger {
  color: var(--clay);
}

.rownote {
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 页脚 ================= */

.about {
  margin-top: var(--sp4);
  text-align: center;
  font-size: var(--fs-label);
  letter-spacing: .08em;
  color: var(--muted2);
}

/* 自定义 tabBar 是固定定位的：页面自己让出它的高度（108rpx + 安全区），否则最后一行被盖住 */
.page { padding-bottom: calc(var(--sp5) + 104rpx + env(safe-area-inset-bottom)); }
