/* ================= 当前计划 ================= */

.card {
  padding: var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  /* 一像素的顶部高光：让卡片像"一张压在底色上的纸"，而不是浮起来的白块 */
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, .7) inset,
              0 2rpx 6rpx rgba(31, 35, 28, .03);
}

.cardlabel {
  font-size: var(--fs-label);
  letter-spacing: .2em;
  color: var(--muted2);
  text-transform: uppercase;
}

.cname {
  margin-top: var(--sp2);
  font-size: var(--fs-h2);
  line-height: 1.3;
}

.planline {
  margin-top: var(--sp2);
  display: flex;
  flex-wrap: wrap;
}

.pk {
  margin-right: var(--sp3);
  margin-top: var(--sp1);
  display: flex;
  align-items: baseline;
}

.pkkey {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  color: var(--clay);
  margin-right: 8rpx;
}

.pkname {
  font-size: var(--fs-note);
  color: var(--muted);
}

.changebtn {
  margin-top: var(--sp3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--sp3);
  border-radius: 44rpx;
  background: var(--soft);
  color: var(--green);
  font-size: var(--fs-note);
  letter-spacing: .06em;
  transition: background-color var(--dur-press) var(--ease-press),
              transform var(--dur-press) var(--ease-press);
}

/* 按下：底色压深一档 + 下沉，箭头往前挪一点，暗示"要进去了" */
.changebtn-hover {
  background: #DDE5C8;
  transform: translateY(1rpx) scale(.997);
}

.changearrow {
  font-family: 'LJGrotesk', sans-serif;
  transition: transform var(--dur-press) var(--ease-press);
}

.changebtn-hover .changearrow {
  transform: translateX(6rpx);
}

/* ================= 选项 ================= */

.chips {
  display: flex;
}

.chip {
  flex: 1;
  height: 88rpx;
  margin-right: var(--sp2);
  border-radius: 44rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--muted);
  transition: background-color .15s var(--ease-press),
              color .15s var(--ease-press),
              border-color .15s var(--ease-press),
              transform var(--dur-press) var(--ease-press);
}

/* 未选中的选项按下去也有反馈：压深 + 微缩 */
.chip-hover {
  background: var(--card-press);
  transform: scale(.98);
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: var(--green);
  border-color: var(--green);
  color: #F6F4EA;
}

.hint {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted2);
}

/* ================= 列表行 ================= */

.rows {
  border-top: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx var(--sp2);
  margin: 0 calc(var(--sp2) * -1);
  border-radius: 12rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background-color var(--dur-press) var(--ease-press);
}

/* 按下：一行被压深，不是变白（原来 hover 到 var(--card) 反而更亮，看着像闪了一下） */
.row-hover {
  background: var(--card-press);
  border-bottom-color: transparent;
}

.rowt {
  font-size: var(--fs-body);
}

.rowt.danger {
  color: var(--clay);
}

.rownote {
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 页脚 ================= */

/* 个人资料：性别 chips + 出生年份 picker（选填） */
.sec-note {
  margin-left: 12rpx;
  font-size: var(--fs-label);
  color: var(--muted2);
  letter-spacing: 0;
}

.pickerrow {
  margin-top: var(--sp1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.pickert {
  font-size: var(--fs-note);
  color: var(--muted);
}

.pickerv {
  font-size: var(--fs-note);
  color: var(--ink);
}

/* 同步状态：一行标题 + 一行实话，点整块立即重试 */
.syncrow {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp2);      /* 下面紧跟备份/恢复列表，留一点呼吸 */
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.smain {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 重试只在失败态出现：同步平时是全自动的，不该给人一个「要按一下」的按钮 */
.sretry {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--soft);
  color: var(--green);
  font-size: var(--fs-note);
}

.sretry-hover {
  background: var(--green);
  color: var(--soft);
}

.stitle {
  font-size: var(--fs-body);
  color: var(--ink);
}

.ssub {
  margin-top: 6rpx;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.syncrow.error .stitle {
  color: var(--clay);
}

.syncrow.wait .stitle {
  color: var(--green);
}

.about {
  margin-top: var(--sp4);
  text-align: center;
  font-size: var(--fs-label);
  letter-spacing: .08em;
  color: var(--muted2);
}

.aboutv { display: block; }

.aboutlnk {
  display: inline-block;
  margin-top: 14rpx;
  color: var(--muted);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.aboutlnk-hover { color: var(--green); }

/* 自定义 tabBar 是固定定位的：页面自己让出它的高度（108rpx + 安全区），否则最后一行被盖住 */
.page { padding-bottom: calc(var(--sp5) + 104rpx + env(safe-area-inset-bottom)); }
