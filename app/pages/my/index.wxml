<view class="sb" style="height:{{sbh + 12}}px"></view>

<view class="page {{enter ? 'enter' : ''}}">

  <view class="phead">
    <view class="brandrow">
      <text class="brand">练界</text>
      <text class="kicker">Settings</text>
    </view>
    <view class="h1en">Your Plan</view>
    <view class="h1">把训练，调成你的。</view>
  </view>

  <!-- 当前计划 -->
  <view class="card sec">
    <view class="cardlabel">当前计划</view>
    <view class="cname">{{profileText}}</view>
    <view class="planline">
      <view class="pk" wx:for="{{planKeys}}" wx:key="key">
        <text class="pkkey">{{item.key}}</text>
        <text class="pkname">{{item.name}}</text>
      </view>
    </view>
    <view class="changebtn" hover-class="changebtn-hover" hover-start-time="0" hover-stay-time="140" bindtap="gotoPrograms">
      <text>换方案 / 自己搭</text>
      <text class="changearrow">→</text>
    </view>
  </view>

  <!-- 身体指标 -->
  <view class="card sec">
    <view class="cardlabel">身体指标</view>
    <view class="cname">体重 · 体脂 · 腰围 · 静息心率</view>
    <view class="changebtn" hover-class="changebtn-hover" hover-start-time="0" hover-stay-time="140" bindtap="gotoMetrics">
      <text>记录今天 / 看趋势</text>
      <text class="changearrow">→</text>
    </view>
  </view>

  <!-- 我的动作 -->
  <view class="card sec">
    <view class="cardlabel">我的动作</view>
    <view class="cname">自己加的动作 · 换动作时能选到</view>
    <view class="changebtn" hover-class="changebtn-hover" hover-start-time="0" hover-stay-time="140" bindtap="gotoMyExercises">
      <text>管理我的动作</text>
      <text class="changearrow">→</text>
    </view>
  </view>

  <!-- 一周几次 -->
  <view class="sec">
    <view class="sec-h">一周练几次</view>
    <view class="chips">
      <view class="chip {{profile.days == 2 ? 'on' : ''}}" data-v="2" bindtap="setDays" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">2 天</view>
      <view class="chip {{profile.days == 3 ? 'on' : ''}}" data-v="3" bindtap="setDays" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">3 天</view>
      <view class="chip {{profile.days == 4 ? 'on' : ''}}" data-v="4" bindtap="setDays" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">4 天</view>
    </view>
  </view>

  <!-- 在哪练 -->
  <view class="sec">
    <view class="sec-h">在哪练</view>
    <view class="chips">
      <view class="chip {{profile.place == 'gym' ? 'on' : ''}}" data-v="gym" bindtap="setPlace" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">健身房</view>
      <view class="chip {{profile.place == 'home' ? 'on' : ''}}" data-v="home" bindtap="setPlace" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">家里</view>
    </view>
  </view>

  <!-- 水平 -->
  <view class="sec">
    <view class="sec-h">水平</view>
    <view class="chips">
      <view class="chip {{profile.level == 'new' ? 'on' : ''}}" data-v="new" bindtap="setLevel" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">刚开始</view>
      <view class="chip {{profile.level == 'some' ? 'on' : ''}}" data-v="some" bindtap="setLevel" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">练过一阵</view>
      <view class="chip {{profile.level == 'trained' ? 'on' : ''}}" data-v="trained" bindtap="setLevel" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">一直在练</view>
    </view>
    <view class="hint">改完立刻生效，之后的训练按新计划走。已有的训练记录不会丢。</view>
  </view>

  <!-- 个人资料（选填）：只服务力量水平评级 -->
  <view class="sec">
    <view class="sec-h">个人资料<text class="sec-note">选填</text></view>
    <view class="chips">
      <view class="chip {{profile.sex == 'm' ? 'on' : ''}}" data-v="m" bindtap="setSex" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">男</view>
      <view class="chip {{profile.sex == 'f' ? 'on' : ''}}" data-v="f" bindtap="setSex" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">女</view>
      <view class="chip {{!profile.sex ? 'on' : ''}}" data-v="" bindtap="setSex" hover-class="chip-hover" hover-start-time="0" hover-stay-time="120">不填</view>
    </view>
    <picker mode="date" fields="year" value="{{birthValue}}" start="1940-01-01" end="{{thisYear}}-12-31" bindchange="setBirth">
      <view class="pickerrow">
        <text class="pickert">出生年份</text>
        <text class="pickerv num">{{profile.birthYear ? profile.birthYear : '不填'}} ▾</text>
      </view>
    </picker>
    <view class="hint">只用来算「力量水平」（估算 1RM ÷ 体重 对照标准表）。不填就不显示评级，别的功能不受影响。</view>
  </view>

  <!-- 同步 -->
  <view class="sec">
    <view class="sec-h">同步</view>
    <view class="syncrow {{syncState}}">
      <view class="smain">
        <text class="stitle">{{syncTitle}}</text>
        <text class="ssub">{{syncSub}}</text>
      </view>
      <text
        wx:if="{{syncState === 'error'}}"
        class="sretry"
        bindtap="tapSync"
        hover-class="sretry-hover"
        hover-start-time="0"
        hover-stay-time="120"
      >重试</text>
    </view>
  </view>

  <!-- 数据 -->
  <view class="sec">
    <view class="sec-h">数据</view>
    <view class="rows">
      <view class="row" wx:if="{{!hasAny}}" bindtap="fillDemo" hover-class="row-hover" hover-start-time="0" hover-stay-time="140">
        <text class="rowt">填入示例数据</text>
        <text class="rownote">用来看图表效果</text>
      </view>
      <view class="row" bindtap="clearData" hover-class="row-hover" hover-start-time="0" hover-stay-time="140">
        <text class="rowt">清空训练记录</text>
        <text class="rownote">保留计划设置</text>
      </view>
      <view class="row" bindtap="exportData" hover-class="row-hover" hover-start-time="0" hover-stay-time="140">
        <text class="rowt">导出我的数据</text>
        <text class="rownote">复制成 JSON</text>
      </view>
      <view class="row" bindtap="restart" hover-class="row-hover" hover-start-time="0" hover-stay-time="140">
        <text class="rowt danger">重新引导</text>
        <text class="rownote">全部重来</text>
      </view>
      <view class="row" bindtap="deleteAccount" hover-class="row-hover" hover-start-time="0" hover-stay-time="140">
        <text class="rowt danger">删除账号</text>
        <text class="rownote">本机与云端一起删</text>
      </view>
    </view>
  </view>

  <view class="about">练界 v0.1</view>

</view>
