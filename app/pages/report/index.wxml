<view class="sb" style="height:{{sbh + 28}}px"></view>

<view class="wrap {{fx ? 'enter-r' : ''}}">

  <view class="head rise d1">
    <view class="kicker">{{dateText}}</view>
    <view class="h1en">Session Report</view>
    <view class="h1">{{head}}</view>
    <view class="plan">{{r.planName}}</view>
  </view>

  <!-- 三个数字 -->
  <view class="nums rise d2">
    <view class="n">
      <view class="v">{{r.sets}}</view>
      <view class="k">组</view>
    </view>
    <view class="n">
      <view class="v">{{r.unit === 'kg' ? r.ton : (r.unit === 'bw' ? r.reps : r.seconds)}}</view>
      <view class="k">{{r.unit === 'kg' ? '吨' : (r.unit === 'bw' ? '次' : '秒')}}</view>
    </view>
    <view class="n">
      <view class="v">{{r.exercises}}</view>
      <view class="k">个动作</view>
    </view>
  </view>

  <!-- PR -->
  <view class="prbox rise d3" wx:if="{{r.prs.length}}">
    <view class="prhead">
      <text class="prdot"></text>
      <text class="prtitle">{{dayWord}}破了 {{r.prs.length}} 个纪录</text>
    </view>
    <view class="prrow" wx:for="{{r.prs}}" wx:key="exId">
      <text class="prcn">{{item.cn}}</text>
      <text class="prw">{{item.weight}}kg</text>
      <text class="prd">+{{item.delta}}</text>
    </view>
  </view>

  <!-- 部位 -->
  <view class="block rise d4" wx:if="{{r.parts.length}}">
    <view class="bh">{{dayWord}}练了</view>
    <view class="prow" wx:for="{{r.parts}}" wx:key="key">
      <text class="nm">{{item.name}}</text>
      <view class="bw"><view class="bf" style="width:{{item.pct}}%"></view></view>
      <text class="pc">{{item.pct}}%</text>
    </view>
  </view>

  <view class="comment rise d5">{{comment}}</view>

</view>

<view class="footbar rise d6">
  <view class="btn ghost" hover-class="btn-hover" bindtap="savePoster">存成图片</view>
  <view class="btn" hover-class="btn-hover" bindtap="done">{{btnText}}</view>
</view>
