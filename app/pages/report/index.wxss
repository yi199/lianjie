/* 战报页刻意换成深色 —— 和其它页面不一样，才有「结束了」的仪式感 */

page {
  background: #2A3226;
}

.wrap {
  padding: 0 48rpx 200rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------------- 头部 ---------------- */

.head {
  margin-top: 40rpx;
}

.kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #8C9A80;
}

.h1 {
  margin-top: 24rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 60rpx;
  color: #F2F0E6;
  line-height: 1.3;
}

.plan {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #A8B79C;
}

/* ---------------- 三个数字 ---------------- */

.nums {
  margin-top: 64rpx;
  display: flex;
  align-items: flex-end;
}

.n {
  margin-right: 56rpx;
}

.n:last-child {
  margin-right: 0;
}

.v {
  font-family: Georgia, serif;
  font-size: 76rpx;
  color: #F2F0E6;
  line-height: 1;
}

.k {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8C9A80;
  letter-spacing: 2rpx;
}

/* ---------------- PR ---------------- */

.prbox {
  margin-top: 56rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(208, 139, 99, .14);
  border: 1rpx solid rgba(208, 139, 99, .35);
}

.prhead {
  display: flex;
  align-items: center;
}

.prdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D08B63;
  margin-right: 14rpx;
}

.prtitle {
  font-size: 24rpx;
  color: #E5A882;
  letter-spacing: 1rpx;
}

.prrow {
  margin-top: 22rpx;
  display: flex;
  align-items: baseline;
}

.prcn {
  font-size: 27rpx;
  color: #F2F0E6;
  flex: 1;
}

.prw {
  font-family: Georgia, serif;
  font-size: 29rpx;
  color: #E5A882;
}

.prd {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8C9A80;
}

/* ---------------- 部位 ---------------- */

.block {
  margin-top: 56rpx;
}

.bh {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: #8C9A80;
  margin-bottom: 26rpx;
}

.prow {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.nm {
  width: 90rpx;
  font-size: 24rpx;
  color: #C8D2BE;
}

.bw {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: #3C4636;
  overflow: hidden;
}

.bf {
  height: 100%;
  border-radius: 4rpx;
  background: #A8BC96;
}

.pc {
  width: 80rpx;
  text-align: right;
  font-size: 21rpx;
  color: #8C9A80;
}

/* ---------------- 评语 ---------------- */

.comment {
  margin-top: 64rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.8;
  color: #A8B79C;
}

/* ---------------- 底部 ---------------- */

.footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 48rpx 48rpx;
  background: #2A3226;
}

.btn {
  height: 100rpx;
  border-radius: 50rpx;
  background: #F2F0E6;
  color: #2A3226;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: .85;
}

/* ---------------- 入场：一块块浮上来 ---------------- */

.rise {
  animation: rise .55s cubic-bezier(.2, .8, .2, 1) both;
}

.d1 { animation-delay: .04s; }
.d2 { animation-delay: .12s; }
.d3 { animation-delay: .22s; }
.d4 { animation-delay: .32s; }
.d5 { animation-delay: .42s; }
.d6 { animation-delay: .52s; }

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
