<view class="page {{leaving ? 'leaving' : ''}}" style="padding-top:{{sbh + 20}}px">

  <view class="hero">
    <view class="mark">力见</view>
    <view class="slogan">把每一次训练留在身体上</view>
  </view>

  <!-- 三个问题压成一屏：全部预选好默认值，什么都不点也能直接开始 -->
  <view class="qs">

    <view class="q">
      <view class="qh">
        <text class="qno">01</text>
        <text class="qt">你练了多久</text>
      </view>
      <view class="chips">
        <view class="chip {{level === 'new' ? 'on' : ''}}" data-v="new" bindtap="pickLevel">刚开始</view>
        <view class="chip {{level === 'some' ? 'on' : ''}}" data-v="some" bindtap="pickLevel">练过一阵</view>
        <view class="chip {{level === 'trained' ? 'on' : ''}}" data-v="trained" bindtap="pickLevel">一直在练</view>
      </view>
    </view>

    <view class="q">
      <view class="qh">
        <text class="qno">02</text>
        <text class="qt">一周练几次</text>
      </view>
      <view class="chips">
        <view class="chip {{days === 2 ? 'on' : ''}}" data-v="2" bindtap="pickDays">2 天</view>
        <view class="chip {{days === 3 ? 'on' : ''}}" data-v="3" bindtap="pickDays">3 天</view>
        <view class="chip {{days === 4 ? 'on' : ''}}" data-v="4" bindtap="pickDays">4 天</view>
      </view>
    </view>

    <view class="q">
      <view class="qh">
        <text class="qno">03</text>
        <text class="qt">在哪练</text>
      </view>
      <view class="chips">
        <view class="chip {{place === 'gym' ? 'on' : ''}}" data-v="gym" bindtap="pickPlace">健身房</view>
        <view class="chip {{place === 'home' ? 'on' : ''}}" data-v="home" bindtap="pickPlace">家里</view>
      </view>
    </view>

  </view>

  <view class="preview" wx:if="{{summary}}">
    <view class="pv-label">你的计划</view>
    <view class="pv-meta">{{meta}}</view>
    <view class="pv-text">{{summary}}</view>
  </view>

  <view class="foot">
    <view class="btn main {{checking ? 'off' : ''}}" bindtap="finish">
      <text>就这样，开始</text>
      <text class="arw">→</text>
    </view>
    <view class="legal" bindtap="gotoPrivacy" hover-class="legal-hover" hover-start-time="0" hover-stay-time="120">
      继续即表示同意《隐私政策与用户协议》
    </view>
  </view>

</view>
