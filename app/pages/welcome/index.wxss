.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 56rpx;
  padding-right: 56rpx;
  padding-bottom: 56rpx;
  background: #F2F0E6;
  display: flex;
  flex-direction: column;
}

/* 进页面时内容依次淡入，不要整屏硬闪 */
.hero,
.qs,
.preview,
.foot {
  animation: stepIn .32s cubic-bezier(.23, .9, .3, 1) both;
}

.qs { animation-delay: .04s; }
.preview { animation-delay: .08s; }
.foot { animation-delay: .12s; }

@keyframes stepIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero, .qs, .preview, .foot { animation: none; }
}

/* ---------------- 品牌 ---------------- */

.hero {
  margin-top: 26rpx;
}

.mark {
  font-family: 'LJGrotesk', sans-serif;
  font-size: 68rpx;
  letter-spacing: 8rpx;
  color: #1F231C;
  line-height: 1.2;
}

.slogan {
  margin-top: 14rpx;
  font-size: var(--fs-note);
  letter-spacing: 1rpx;
  color: #8B8878;
}

/* ---------------- 三个问题（一屏） ---------------- */

.qs {
  margin-top: 60rpx;
}

.q + .q {
  margin-top: 44rpx;
}

.qh {
  display: flex;
  align-items: baseline;
}

.qno {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #B4795A;
  margin-right: 12rpx;
}

.qt {
  font-family: 'LJGrotesk', sans-serif;
  font-size: 34rpx;
  color: #1F231C;
}

.chips {
  margin-top: 22rpx;
  display: flex;
}

.chip {
  flex: 1;
  height: 88rpx;
  margin-right: 18rpx;
  border-radius: 44rpx;
  border: 1rpx solid #DFDCCE;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: #4A4A3E;
  transition: background .18s, color .18s, border-color .18s, transform .12s;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: #3C4A32;
  border-color: #3C4A32;
  color: #F6F4EA;
  transform: translateY(-2rpx);
}

/* ---------------- 计划摘要 ---------------- */

.preview {
  margin-top: 48rpx;
  padding: 28rpx 32rpx;
  background: #ECEEE3;
  border-radius: 24rpx;
}

.pv-label {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #7C8A70;
}

.pv-meta {
  margin-top: 14rpx;
  font-size: var(--fs-label);
  color: #7C8A70;
  letter-spacing: 1rpx;
}

.pv-text {
  margin-top: 10rpx;
  font-size: var(--fs-body);
  color: #3C4A32;
  line-height: 1.5;
}

/* ---------------- 底部 ---------------- */

.foot {
  margin-top: auto;
  padding-top: 48rpx;
}

.btn.main {
  height: 104rpx;
  border-radius: 52rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line, #EBE8DC);
  color: #1F231C;
  font-size: var(--fs-body);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  transition: background .15s;
}

.btn.main .arw {
  font-family: 'LJGrotesk', sans-serif;
  color: var(--muted, #8B897C);
}

.btn.main.off {
  background: #F7F6EE;
  color: #B8B5A6;
  border-color: #EFEDE2;
}

/* 「继续即表示同意《隐私政策与用户协议》」——可点，但视觉上压在最后一行 */
.legal {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-label);
  color: var(--muted2);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.legal-hover { color: var(--green); }
