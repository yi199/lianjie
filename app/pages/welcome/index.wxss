.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 56rpx;
  padding-right: 56rpx;
  padding-bottom: 60rpx;
  background: #F2F0E6;
  display: flex;
  flex-direction: column;
}

/* 三屏之间切换时内容淡入，不要硬切 */
.hero,
.qhead,
.opts,
.chips,
.preview,
.foot {
  animation: stepIn .3s cubic-bezier(.23, .9, .3, 1) both;
}

@keyframes stepIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero, .qhead, .opts, .chips, .preview, .foot {
    animation: none;
  }
}

/* ---------------- ① 品牌 ---------------- */

.hero {
  margin-top: 110rpx;
}

.mark {
  font-family: 'LJGrotesk', sans-serif;
  font-size: 100rpx;
  letter-spacing: 10rpx;
  color: #1F231C;
  line-height: 1.2;
}

.rule {
  width: 64rpx;
  height: 3rpx;
  background: #3C4A32;
  margin: 40rpx 0 48rpx;
}

.slogan {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-h2);
  line-height: 1.7;
  color: #3C4A32;
}

.en {
  margin-top: 64rpx;
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #A9A79A;
}

/* ---------------- ②③ 提问 ---------------- */

.qhead {
  margin-top: 48rpx;
}

.qhead.mt {
  margin-top: 72rpx;
}

.qno {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #B4795A;
}

.qtitle {
  margin-top: 18rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-h1);
  color: #1F231C;
}

.qsub {
  margin-top: 14rpx;
  font-size: var(--fs-note);
  color: #8B8878;
}

.opts {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
}

.opt {
  margin-bottom: 24rpx;
  padding: 34rpx 32rpx;
  border: 1rpx solid #DFDCCE;
  border-radius: 26rpx;
  background: #FFFFFF;
  transition: background .15s, border-color .15s;
}

.opt.on {
  background: #ECEEE3;
  border-color: #3C4A32;
}

.ot {
  font-size: var(--fs-body);
  color: #1F231C;
}

.od {
  margin-top: 10rpx;
  font-size: var(--fs-note);
  color: #8B8878;
  line-height: 1.5;
}

.chips {
  margin-top: 32rpx;
  display: flex;
}

.chip {
  flex: 1;
  height: 92rpx;
  margin-right: 20rpx;
  border-radius: 46rpx;
  border: 1rpx solid #DFDCCE;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: #4A4A3E;
  transition: background .15s, color .15s;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: #3C4A32;
  border-color: #3C4A32;
  color: #F6F4EA;
}

.preview {
  margin-top: 56rpx;
  padding: 32rpx;
  background: #ECEEE3;
  border-radius: 24rpx;
}

.pv-label {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #7C8A70;
}

.pv-text {
  margin-top: 16rpx;
  font-size: var(--fs-body);
  color: #3C4A32;
  line-height: 1.5;
}

.pv-note {
  margin-top: 14rpx;
  font-size: var(--fs-label);
  color: #A9A79A;
}

/* ---------------- 底部 ---------------- */

.foot {
  margin-top: auto;
  padding-top: 60rpx;
}

.btn.main {
  height: 104rpx;
  border-radius: 52rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line, #EBE8DC);
  color: #1F231C;
  font-size: var(--fs-body);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  transition: background .15s;
}

.btn.main .arw {
  font-family: 'LJGrotesk', sans-serif;
  color: var(--muted, #8B897C);
}

.btn.main.off {
  background: #F7F6EE;
  color: #B8B5A6;
  border-color: #EFEDE2;
}

.hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: var(--fs-note);
  color: #A9A79A;
}

.back {
  margin-top: 30rpx;
  text-align: center;
  font-size: var(--fs-note);
  color: #8B8878;
}

.dots {
  margin-top: 36rpx;
  display: flex;
  justify-content: center;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D5D2C4;
  margin: 0 6rpx;
  transition: background .2s;
}

.dot.on {
  background: #3C4A32;
}
