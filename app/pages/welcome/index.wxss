.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 56rpx;
  padding-right: 56rpx;
  padding-bottom: 240rpx;   /* 给固定底栏让位 */
  background: #F2F0E6;
  display: flex;
  flex-direction: column;
}

/* 进页面时内容依次淡入，不要整屏硬闪 */
.hero,
.qs,
.preview,
.foot {
  animation: stepIn .32s cubic-bezier(.23, .9, .3, 1) both;
}

.qs { animation-delay: .04s; }
.preview { animation-delay: .08s; }
.foot { animation-delay: .12s; }

@keyframes stepIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero, .qs, .preview, .foot { animation: none; }
}

/* ---------------- 品牌 ---------------- */

.hero {
  margin-top: 6rpx;
}

.mark {
  font-family: 'LJGrotesk', sans-serif;
  font-size: 62rpx;
  letter-spacing: 8rpx;
  color: #1F231C;
  line-height: 1.2;
}

.slogan {
  margin-top: 10rpx;
  font-size: var(--fs-note);
  letter-spacing: 1rpx;
  color: #8B8878;
}

/* ---------------- 三个问题（一屏） ---------------- */

/* 三问吃掉中间的全部剩余高度：高屏自然铺开、低屏自动收紧，不再挤在顶部 */
.qs {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  margin-top: 18rpx;
}

.q {
  margin: 10rpx 0;
}

.qh {
  display: flex;
  align-items: baseline;
}

.qno {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #B4795A;
  margin-right: 12rpx;
}

.qt {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-h2);
  color: #1F231C;
}

.chips {
  margin-top: 22rpx;
  display: flex;
}

.chip {
  flex: 1;
  height: 96rpx;
  margin-right: 18rpx;
  border-radius: 48rpx;
  border: 1rpx solid #DFDCCE;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: #4A4A3E;
  transition: background .18s, color .18s, border-color .18s, transform .12s;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: #3C4A32;
  border-color: #3C4A32;
  color: #F6F4EA;
  transform: translateY(-2rpx);
}

/* ---------------- 计划摘要 ---------------- */

.preview {
  margin-bottom: 8rpx;
  padding: 26rpx 30rpx;
  background: #ECEEE3;
  border-radius: 24rpx;
}

.pv-label {
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
  color: #7C8A70;
}

.pv-meta {
  margin-top: 14rpx;
  font-size: var(--fs-label);
  color: #7C8A70;
  letter-spacing: 1rpx;
}

.pv-text {
  margin-top: 10rpx;
  font-size: var(--fs-body);
  color: #3C4A32;
  line-height: 1.5;
}

/* ---------------- 底部 ---------------- */

.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 56rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(242, 240, 230, 0) 0%, #F2F0E6 26%, #F2F0E6 100%);
}

.btn.main {
  height: 104rpx;
  border-radius: 52rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line, #EBE8DC);
  color: #1F231C;
  font-size: var(--fs-body);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  transition: background .15s;
}

.btn.main .arw {
  font-family: 'LJGrotesk', sans-serif;
  color: var(--muted, #8B897C);
}

.btn.main.off {
  background: #F7F6EE;
  color: #B8B5A6;
  border-color: #EFEDE2;
}

/* ---------------- 协议勾选（审核要求：用户主动勾选，不得默认同意） ---------------- */

.legal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 自绘勾选框：不用第三方图标库（版权红线） */
.box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C4C1B2;
  background: #FFFFFF;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: background .18s, border-color .18s, transform .12s;
}

.box.on {
  background: #3C4A32;
  border-color: #3C4A32;
}

.box-hover {
  transform: scale(0.9);
}

/* 对勾：两根旋转的条拼成，纯 CSS 自绘 */
.tick {
  width: 15rpx;
  height: 9rpx;
  border-left: 3rpx solid #F6F4EA;
  border-bottom: 3rpx solid #F6F4EA;
  transform: rotate(-45deg) translateY(-2rpx);
}

.legal-text {
  font-size: var(--fs-label);
  color: var(--muted2);
  letter-spacing: 0.5rpx;
}

.legal-link {
  color: var(--green);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.legal-hover .legal-link {
  color: var(--green-deep);
}

/* 未勾选就点开始：勾选框左右抖一下，代替弹窗打断 */
.box.shake {
  animation: boxShake .42s cubic-bezier(.36, .07, .19, .97) both;
}

@keyframes boxShake {
  10%, 90% { transform: translateX(-2rpx); }
  20%, 80% { transform: translateX(4rpx); }
  30%, 50%, 70% { transform: translateX(-7rpx); }
  40%, 60% { transform: translateX(7rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .box.shake { animation: none; }
}
