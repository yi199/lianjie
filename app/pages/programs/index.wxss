/* ================= 当前方案 ================= */

.card {
  padding: var(--sp3);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.cardlabel {
  font-size: var(--fs-label);
  letter-spacing: .2em;
  color: var(--muted2);
  text-transform: uppercase;
}

.cname {
  margin-top: var(--sp2);
  font-size: var(--fs-h2);
  line-height: 1.35;
}

.planline {
  margin-top: var(--sp2);
  display: flex;
  flex-wrap: wrap;
}

.pk {
  margin-right: var(--sp3);
  margin-top: var(--sp1);
  display: flex;
  align-items: baseline;
}

.pkkey {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  color: var(--clay);
  margin-right: 8rpx;
}

.pkname {
  font-size: var(--fs-note);
  color: var(--muted);
}

.cbtn {
  margin-top: var(--sp3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 var(--sp3);
  border-radius: 46rpx;
  background: var(--green);
  color: #F6F4EA;
  font-size: var(--fs-body);
  letter-spacing: .06em;
}

.cbtn-hover {
  opacity: .92;
  transform: scale(.99);
}

.carrow {
  font-family: 'LJGrotesk', sans-serif;
  opacity: .8;
}

/* ================= 方案卡 ================= */

.pcard {
  margin-bottom: var(--sp2);
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  overflow: hidden;
}

.pcard.on {
  border-color: rgba(60, 74, 50, .45);
  background: #FBFCF6;
}

.pbody {
  padding: var(--sp3);
}

.ptop {
  display: flex;
  align-items: baseline;
}

.pname {
  font-size: var(--fs-h2);
  line-height: 1.3;
}

.pen {
  margin-left: auto;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .18em;
  color: var(--muted2);
  text-transform: uppercase;
}

.pdesc {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  line-height: 1.72;
  color: var(--muted);
}

.pmeta {
  margin-top: var(--sp2);
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.pm {
  flex-shrink: 0;          /* 「一周 2 练」不能被挤断成两行（换字体后数字更宽） */
  white-space: nowrap;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.pdot {
  margin: 0 10rpx;
  font-size: var(--fs-note);
  color: var(--muted2);
}

.ptags {
  margin-top: var(--sp2);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.ptag {
  margin-right: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--soft);
  color: var(--green);
  font-size: var(--fs-label);
  letter-spacing: .04em;
}

.pexp {
  margin-left: auto;
  font-size: var(--fs-note);
  color: var(--green);
}

.psess {
  margin-top: var(--sp2);
  font-size: var(--fs-note);
  color: var(--muted);
}

/* ================= 展开的动作 ================= */

.pex {
  padding: 0 var(--sp3) var(--sp2);
  border-top: 1rpx dashed var(--line);
}

.pexday {
  margin-top: var(--sp2);
}

.pexh {
  display: flex;
  align-items: baseline;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid var(--line);
}

.pexkey {
  font-size: var(--fs-note);
  color: var(--clay);
  margin-right: 12rpx;
}

.pexname {
  font-size: var(--fs-body);
}

.pexen {
  margin-left: 12rpx;
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-label);
  letter-spacing: .14em;
  color: var(--muted2);
  text-transform: uppercase;
}

.pexrow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 0;
}

.pexcn {
  font-size: var(--fs-note);
  color: var(--ink);
}

.pexss {
  font-size: var(--fs-note);
  color: var(--muted2);
}

/* ================= 按钮行 ================= */

.pfoot {
  padding: 0 var(--sp3) var(--sp3);
}

.pfoot-split {
  display: flex;
  align-items: center;
}

.puse {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--soft);
  color: var(--green);
  font-size: var(--fs-body);
  letter-spacing: .06em;
}

.puse.on {
  background: transparent;
  border: 1rpx solid rgba(60, 74, 50, .28);
  color: var(--muted2);
}

.puse-hover {
  opacity: .88;
}

.pedit,
.pdel {
  height: 84rpx;
  padding: 0 var(--sp3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--muted);
}

.pdel {
  color: var(--clay);
}

.pfoot-split .puse {
  flex: 0 0 200rpx;
  margin-left: auto;
}

/* ================= 自动排 ================= */

.autorow {
  margin-top: var(--sp2);
  padding: var(--sp3);
  border-radius: 24rpx;
  border: 1rpx dashed var(--line);
  display: flex;
  align-items: center;
}

.autorow.on {
  border-style: solid;
  border-color: rgba(60, 74, 50, .4);
  background: #FBFCF6;
}

.autorow-hover {
  background: var(--card);
}

.autorowl {
  flex: 1;
  padding-right: var(--sp2);
}

.autoron {
  font-size: var(--fs-body);
}

.autonote {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--muted2);
}

.autorowtag {
  font-size: var(--fs-note);
  color: var(--green);
}

/* ================= 空态 / 底部 ================= */

.empty {
  padding: var(--sp3) 0 var(--sp2);
}

.emptyt {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink);
}

.emptyd {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--muted2);
}

.buildbtn {
  margin-top: var(--sp2);
}

.about {
  margin-top: var(--sp4);
  text-align: center;
  font-size: var(--fs-label);
  letter-spacing: .08em;
  color: var(--muted2);
}
