<view class="bar skin-{{skin}}">
  <!-- 滑块：外层只负责「对齐到第 N 个三分之一」，内层做视觉。
       分两层的原因：translateX(N * 100%) 里的 100% 是**自身宽度**，
       如果外层宽度就是「三分之一减间距」，第二个、第三个 tab 会累积错位。 -->
  <view class="pill {{noFx ? 'nofx' : ''}}" style="transform: translateX({{pos * 100}}%)">
    <view class="pill-in"></view>
  </view>

  <view
    class="item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-i="{{index}}"
    bindtap="switchTab"
    hover-class="item-hover"
    hover-start-time="0"
    hover-stay-time="120"
  >
    <image class="ic" src="{{selected === index ? item.on : item.icon}}" mode="aspectFit" style="width: 40rpx; height: 40rpx;" />
    <text class="lb">{{item.text}}</text>
  </view>
</view>
