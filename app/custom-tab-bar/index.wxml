<view class="bar">
  <!-- 选中项上方那道小把手：陶土色，28rpx 宽，贴在栏的上沿 -->
  <view class="mark {{selected === 0 ? 'at0' : (selected === 1 ? 'at1' : 'at2')}}"></view>

  <view
    class="item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-i="{{index}}"
    bindtap="switchTab"
    hover-class="item-hover"
    hover-start-time="0"
    hover-stay-time="120"
  >
    <image class="ic" src="{{selected === index ? item.on : item.icon}}" mode="aspectFit" style="width: 44rpx; height: 44rpx;" />
    <text class="lb">{{item.text}}</text>
  </view>
</view>
