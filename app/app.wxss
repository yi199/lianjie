/* ============================================================
   练界 · 设计令牌

   字号只允许用下面这 7 档，间距只用 5 档。
   新增样式时不要随手写 21rpx、23rpx 这种中间值——
   那 7 个差 1rpx 的字号挤在一起，正是「没有层次感」的来源。

   label  19  英文小标签、区块头（字距拉开）
   note   24  辅助说明、上次记录、单位
   body   30  正文、按钮文字、列表项
   h2     38  区块标题、动作名
   h1     46  次级大标题
   title  60  页面主标题
   display 96 品牌字
   ============================================================ */

page {
  /* 颜色 */
  --bg: #F2F0E6;
  --card: #FBF8EF;          /* 纸卡：比底色亮一档的暖白，不是纯白 */
  --card-press: #F1ECDD;    /* 按下时纸被压深的一档 */
  --press-glow: rgba(31, 35, 28, .05);
  --ink: #1F231C;
  --green: #3C4A32;
  --green-deep: #2A3226;
  --soft: #E8EEDC;
  --line: #EBE8DC;
  --muted: #8B897C;
  --muted2: #A9A79A;
  --clay: #B4795A;

  /* 字号 */
  --fs-label: 19rpx;
  --fs-note: 24rpx;
  --fs-body: 30rpx;
  --fs-h2: 38rpx;
  --fs-h1: 46rpx;
  --fs-title: 60rpx;
  --fs-display: 96rpx;
  --fs-num: 76rpx;

  /* 动效：按压统一 120ms，ease-out，按下要"立刻"有反应 */
  --ease-press: cubic-bezier(.2, .8, .2, 1);
  --dur-press: 120ms;

  /* 间距 */
  --sp1: 12rpx;
  --sp2: 24rpx;
  --sp3: 40rpx;
  --sp4: 64rpx;
  --sp5: 96rpx;

  background: var(--bg);
  color: var(--ink);
  /* 中文：思源黑体子集（100~900 可变字重）；没加载成功就回落到系统黑体 */
  font-family: 'LJSans', -apple-system, "PingFang SC", "HarmonyOS Sans SC",
               "MiSans", "Noto Sans SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.6;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* ================= 文字层级 ================= */

/* 英文/数字：Space Grotesk，几何感强，比 Georgia 精神得多 */
.kicker {
  font-family: 'LJGrotesk', -apple-system, "Helvetica Neue", Arial, sans-serif;
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: .28em;
  color: var(--muted2);
  text-transform: uppercase;
}

.h1 {
  font-size: var(--fs-title);
  line-height: 1.22;
  letter-spacing: -.022em;
  font-weight: 800;
}

/* 中文大标题上面那行英文：整页的双层标题结构
   （学杯间餐时：CITY COCKTAILS 在上，「把杭州，调进一杯。」在下） */
.h1en {
  margin-top: 0;
  font-family: 'LJGrotesk', -apple-system, "Helvetica Neue", Arial, sans-serif;
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: .32em;
  color: var(--muted2);
  text-transform: uppercase;
}

.phead .h1en {
  margin-top: var(--sp2);
}

.phead .h1 {
  margin-top: var(--sp1);
}

.h2 {
  font-size: var(--fs-h2);
  line-height: 1.3;
}

.sub {
  font-size: var(--fs-note);
  line-height: 1.75;
  color: var(--muted);
}

.note {
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--muted2);
}

.num {
  font-family: 'LJGrotesk', sans-serif;
  font-variant-numeric: tabular-nums;
}

/* ================= 页面骨架（所有页面共用） ================= */

.page {
  min-height: 100vh;
  padding: 0 var(--sp3) var(--sp5);
}

/* 页头：品牌 + 日期 / 大标题 / 一句话 */
.phead {
  padding-top: var(--sp2);
}

.brandrow {
  display: flex;
  align-items: baseline;
}

.brand {
  font-family: 'LJGrotesk', sans-serif;
  font-size: var(--fs-note);
  letter-spacing: .3em;
  color: var(--ink);
}

.brandrow .kicker {
  margin-left: auto;
}

.phead .h1 {
  margin-top: var(--sp2);
}

.phead .sub {
  margin-top: var(--sp1);
}

/* 区块 */
.sec {
  margin-top: var(--sp4);
}

.sec-h {
  font-size: var(--fs-label);
  letter-spacing: .2em;
  color: var(--muted2);
  text-transform: uppercase;
  margin-bottom: var(--sp2);
}

.hr {
  height: 1rpx;
  background: var(--line);
}

/* 全局按压过渡：所有可点的纸面元素共用一套时长和曲线（120ms / ease-out）。
   各页只需要定义「按下时什么样」，不用重复写 transition。 */
.btn, .cbtn, .savebtn, .sheetok, .swap, .back, .dayadd, .puse, .pedit, .pdel,
.swapline, .ebtn, .autorow, .barsave, .changebtn, .chip, .row, .plist .pitem {
  transition: background-color var(--dur-press) var(--ease-press),
              border-color var(--dur-press) var(--ease-press),
              color var(--dur-press) var(--ease-press),
              transform var(--dur-press) var(--ease-press);
}

/* ================= 按钮 ================= */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: var(--fs-body);
  letter-spacing: .08em;
  /* 纸被按下去：底色压深一档、整体下沉 1rpx，比单纯降透明度更"实" */
  transition: background-color var(--dur-press) var(--ease-press),
              border-color var(--dur-press) var(--ease-press),
              transform var(--dur-press) var(--ease-press);
}

.btn-hover {
  background: var(--card-press);
  border-color: rgba(60, 74, 50, .22);
  transform: translateY(1rpx) scale(.996);
}

.btn-ghost {
  background: transparent;
  color: var(--green);
  border: 1rpx solid rgba(60, 74, 50, .28);
}

/* 幽灵按钮按下去不能变成实心：只加一层很淡的绿雾 */
.btn-ghost.btn-hover {
  background: rgba(60, 74, 50, .06);
  border-color: rgba(60, 74, 50, .38);
  transform: translateY(1rpx) scale(.996);
}

/* ================= 页面转场 =================
   switchTab 切换本身没有动画，所以内容层自己淡入一下；
   navigateTo 的淡入由 animationType 控制（见各页 js）。
*/

@keyframes pageIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes pageOut {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-10rpx); }
}

.page.enter {
  animation: pageIn .26s cubic-bezier(.23, .9, .3, 1) both;
}

.page.leaving {
  animation: pageOut .2s ease forwards;
}

/* 尊重系统的「减弱动态效果」开关 */
@media (prefers-reduced-motion: reduce) {
  .page.enter,
  .page.leaving {
    animation: none;
  }
}

/* ================= 底部操作区 ================= */

.footbar {
  padding: var(--sp2) var(--sp3) calc(var(--sp2) + env(safe-area-inset-bottom));
  background: var(--bg);
}
