/* ============================================================
   练界 · 设计令牌

   字号只允许用下面这 7 档，间距只用 5 档。
   新增样式时不要随手写 21rpx、23rpx 这种中间值——
   那 7 个差 1rpx 的字号挤在一起，正是「没有层次感」的来源。

   label  19  英文小标签、区块头（字距拉开）
   note   24  辅助说明、上次记录、单位
   body   30  正文、按钮文字、列表项
   h2     38  区块标题、动作名
   h1     46  次级大标题
   title  60  页面主标题
   display 96 品牌字
   ============================================================ */

page {
  /* 颜色 */
  --bg: #F2F0E6;
  --card: #FAF9F3;
  --ink: #1F231C;
  --green: #3C4A32;
  --green-deep: #2A3226;
  --soft: #E8EEDC;
  --line: #DFDCCE;
  --muted: #8B897C;
  --muted2: #A9A79A;
  --clay: #B4795A;

  /* 字号 */
  --fs-label: 19rpx;
  --fs-note: 24rpx;
  --fs-body: 30rpx;
  --fs-h2: 38rpx;
  --fs-h1: 46rpx;
  --fs-title: 60rpx;
  --fs-display: 96rpx;
  --fs-num: 76rpx;

  /* 间距 */
  --sp1: 12rpx;
  --sp2: 24rpx;
  --sp3: 40rpx;
  --sp4: 64rpx;
  --sp5: 96rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", "STSong", SimSun, serif;
  font-size: var(--fs-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* ================= 文字层级 ================= */

.kicker {
  font-family: Georgia, "Times New Roman", serif;
  font-size: var(--fs-label);
  letter-spacing: .26em;
  color: var(--muted2);
  text-transform: uppercase;
}

.h1 {
  font-size: var(--fs-title);
  line-height: 1.24;
  letter-spacing: .01em;
  font-weight: 400;
}

/* 中文大标题下面那行英文：整页的双层标题结构 */
.h1en {
  margin-top: var(--sp1);
  font-family: Georgia, "Times New Roman", serif;
  font-size: var(--fs-label);
  letter-spacing: .3em;
  color: var(--muted2);
  text-transform: uppercase;
}

.h2 {
  font-size: var(--fs-h2);
  line-height: 1.3;
}

.sub {
  font-size: var(--fs-note);
  line-height: 1.75;
  color: var(--muted);
}

.note {
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--muted2);
}

.num {
  font-family: Georgia, serif;
  font-variant-numeric: tabular-nums;
}

/* ================= 页面骨架（所有页面共用） ================= */

.page {
  min-height: 100vh;
  padding: 0 var(--sp3) var(--sp5);
}

/* 页头：品牌 + 日期 / 大标题 / 一句话 */
.phead {
  padding-top: var(--sp2);
}

.brandrow {
  display: flex;
  align-items: baseline;
}

.brand {
  font-family: Georgia, "Songti SC", serif;
  font-size: var(--fs-note);
  letter-spacing: .3em;
  color: var(--ink);
}

.brandrow .kicker {
  margin-left: auto;
}

.phead .h1 {
  margin-top: var(--sp2);
}

.phead .sub {
  margin-top: var(--sp1);
}

/* 区块 */
.sec {
  margin-top: var(--sp4);
}

.sec-h {
  font-size: var(--fs-label);
  letter-spacing: .2em;
  color: var(--muted2);
  text-transform: uppercase;
  margin-bottom: var(--sp2);
}

.hr {
  height: 1rpx;
  background: var(--line);
}

/* ================= 按钮 ================= */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--green);
  color: #F6F4EA;
  font-size: var(--fs-body);
  letter-spacing: .08em;
}

.btn-hover {
  opacity: .9;
  transform: scale(.985);
}

.btn-ghost {
  background: transparent;
  color: var(--green);
  border: 1rpx solid rgba(60, 74, 50, .28);
}

/* ================= 底部操作区 ================= */

.footbar {
  padding: var(--sp2) var(--sp3) calc(var(--sp2) + env(safe-area-inset-bottom));
  background: var(--bg);
}
