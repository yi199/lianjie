/* ===== 全局 ===== */
page {
  --bg: #F2F0E6;
  --card: #FAF9F3;
  --ink: #1F231C;
  --green: #3C4A32;
  --soft: #E8EEDC;
  --line: #DFDCCE;
  --muted: #8B897C;
  --muted2: #A9A79A;
  --clay: #B4795A;

  background: #F2F0E6;
  color: #1F231C;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", "STSong", SimSun, serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* ===== 排版 ===== */
.kicker {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18rpx;
  letter-spacing: .24em;
  color: var(--muted2);
  text-transform: uppercase;
}
.h1 {
  font-size: 58rpx;
  line-height: 1.32;
  letter-spacing: .02em;
  font-weight: 400;
}
.sub {
  font-size: 24rpx;
  line-height: 1.85;
  color: var(--muted);
}
.num { font-family: Georgia, serif; }

/* ===== 通用块 ===== */
.page-wrap { padding: 24rpx 44rpx 0; }
.hr { height: 1rpx; background: var(--line); }

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 52rpx;
  background: var(--green);
  color: #F6F4EA;
  font-size: 28rpx;
  letter-spacing: .06em;
}
.btn-hover { opacity: .92; transform: scale(.985); }
.btn-ghost {
  background: transparent;
  color: var(--green);
  border: 1rpx solid rgba(60, 74, 50, .28);
}

/* ===== 底部操作区 ===== */
.footbar {
  padding: 24rpx 40rpx 28rpx;
  background: var(--bg);
}
