.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line, #DFDCCE);
}

.idx {
  width: 36rpx;
  flex-shrink: 0;
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: var(--muted2, #A9A79A);
}

/* 重量 / 次数：看起来像数字，点上去就能改 */
.cell {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.num {
  font-family: Georgia, serif;
  font-size: 34rpx;
  color: var(--ink, #1F231C);
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  height: 46rpx;
  min-height: 46rpx;
  line-height: 46rpx;
  text-align: left;
  width: 96rpx;
}

/* 第一列（重量）稍宽，第三列（次数）窄一点 */
.cell:nth-of-type(1) .num { width: 104rpx; }
.cell:nth-of-type(2) .num { width: 84rpx; }

.ph {
  color: #C6C3B4;
  font-size: 28rpx;
}

.unit {
  font-size: 21rpx;
  color: var(--muted2, #A9A79A);
  margin-left: 4rpx;
  flex-shrink: 0;
}

.x {
  color: var(--muted2, #A9A79A);
  font-size: 22rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 16rpx;
  background: #F2E6C9;
  color: #7A6021;
  border-radius: 12rpx;
  padding: 4rpx 10rpx;
  flex-shrink: 0;
}

.chk {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #CFCCBC;
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .18s, border-color .18s;
}
.row.done .chk {
  background: var(--green, #3C4A32);
  border-color: var(--green, #3C4A32);
}
.ck {
  color: #F6F4EA;
  font-size: 24rpx;
  line-height: 1;
}

/* 已完成的组文字变淡（但输入框仍可点，方便改错） */
.row.done .num {
  color: var(--muted2, #A9A79A);
}
