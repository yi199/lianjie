<view class="row {{done ? 'done' : ''}}">
  <text class="idx">{{no}}</text>

  <!-- 重量栏：kg / 自重（额外负重）才有；计时动作整栏不出现 -->
  <block wx:if="{{showWeight}}">
    <view class="cell c-weight">
      <input
        class="num"
        type="digit"
        value="{{wDisplay}}"
        placeholder="{{unit === 'bw' ? '负重' : '0'}}"
        placeholder-class="ph"
        disabled="{{!editable}}"
        bindblur="onWeightBlur"
        bindconfirm="onWeightBlur"
        cursor-spacing="30"
      />
      <text class="unit" wx:if="{{showKg && wDisplay}}">kg</text>
    </view>
    <text class="x">×</text>
  </block>

  <view class="cell c-reps">
    <input
      class="num"
      type="number"
      value="{{rDisplay}}"
      placeholder="0"
      placeholder-class="ph"
      disabled="{{!editable}}"
      bindblur="onRepsBlur"
      bindconfirm="onRepsBlur"
      cursor-spacing="30"
    />
    <text class="unit" wx:if="{{repsSuffix}}">{{repsSuffix}}</text>
  </view>

  <text class="tag" wx:if="{{pr}}">PR</text>

  <view class="chk" bindtap="onToggle">
    <text wx:if="{{done}}" class="ck">✓</text>
  </view>
</view>
