# 依赖
node_modules/
miniprogram_npm/

# 微信开发者工具本地配置（含本机路径，不要提交）
project.private.config.json

# 临时与构建产物
_cache/
dist/
*.log

# 系统
.DS_Store
Thumbs.db
desktop.ini

# ---- 敏感信息：绝对不要入库 ----
# 环境变量（真实值只放本机；带 example 后缀的模板必须保留，方便别人照着填）
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# 证书与私钥（HTTPS / SSH / 支付）
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# 数据库导出与备份（含真实用户数据）
*.dump
*.sql.gz
*.bak

# 部署覆盖配置（常含生产口令）
docker-compose.override.yml
docker-compose.prod.yml

# 误把仓库根当成小程序目录导入开发者工具时生成，不该入库。
# 注意必须写成根锚定 /project.config.json —— 写成 project.config.json
# 会把 app/project.config.json 也一起忽略掉，那是要入库的项目配置
/project.config.json

# 编辑器与本机工具目录
.vscode/
.idea/

# ---- 设计与原型产物：只保留在本地，不入库 ----
# 仓库里只放小程序代码 + 产品文档，界面原型和设计稿不同步上来
原型/
参考截图/
*.xlsx
功能模块清单.html
练界_小程序演示.html

# 本机工具配置（团结引擎 MCP，跟本项目无关）
.codely-cli/

# Go 编译产物
server/api.exe
server/api
*.exe

# 后端本地环境变量（含密钥）
server/.env
