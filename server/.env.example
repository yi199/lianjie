# 复制成 .env 后按需修改（docker compose 会自动读 .env）
# ⚠️ .env 不要提交到仓库（.gitignore 已排除）

# 服务监听地址（容器内，宿主机统一走 nginx）
ADDR=:8080

# 数据库：compose 会用 POSTGRES_* 建库，api 用下面这条连
POSTGRES_USER=lianjie
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lianjie
# 本地直连（不起 compose 时用）：
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lianjie?sslmode=disable

# JWT 签名密钥 —— 上线必须换成一串长随机值，否则非 DEV_MODE 会拒绝启动
# 生成：openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# 微信小程序凭证（小程序后台 → 开发 → 开发设置）
WECHAT_APPID=
WECHAT_SECRET=

# 联调模式：true 时不校验微信，/login 传什么 code 就对应什么用户（dev-<code>）
# 上线必须设成 false
DEV_MODE=true

# 「今天」按哪个时区算（影响 streak / 今日战报的跨零点行为）
TZ_NAME=Asia/Shanghai
