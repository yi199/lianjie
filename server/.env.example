# 复制成 .env 后按需修改（docker compose 会自动读 .env）
# ⚠️ .env 不要提交到仓库

# 服务监听地址
ADDR=:8080

# 数据库
DATABASE_URL=postgres://lianjie:lianjie_dev_pw@db:5432/lianjie?sslmode=disable

# JWT 签名密钥 —— 上线必须换成一串长随机值
# 生成：openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# 微信小程序凭证（小程序后台 → 开发 → 开发设置）
WECHAT_APPID=
WECHAT_SECRET=

# 联调模式：true 时不校验微信，/login 传什么 code 就对应什么用户（dev-<code>）
# 上线必须设成 false
DEV_MODE=true

# 「今天」按哪个时区算（影响 streak / 今日战报的跨零点行为）
TZ_NAME=Asia/Shanghai
